diff --git a/java/res/values/raven_glass.xml b/java/res/values/raven_glass.xml
new file mode 100644
index 0000000..59c2e07
--- /dev/null
+++ b/java/res/values/raven_glass.xml
@@ -0,0 +1,33 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: 2026 RavenOS
+     SPDX-License-Identifier: Apache-2.0
+-->
+<!-- RavenOS glass keyboard tokens. These are the Midnight Aurora values; the product picks a
+     variant by overlaying this file from vendor/ravenos/themes/<variant>/ (see THEME.md). -->
+<resources>
+    <!-- Backdrop: the bottom band of the Settings backdrop, so the keyboard reads as part of
+         the screen behind it. -->
+    <color name="raven_bg">#FF070B1D</color>
+    <color name="raven_glow_1">#CC0D9488</color>
+    <color name="raven_glow_2">#AA7C3AED</color>
+
+    <color name="raven_key">#1AFFFFFF</color>
+    <color name="raven_key_stroke">#24BAE6FD</color>
+    <color name="raven_key_functional">#0DFFFFFF</color>
+    <color name="raven_key_pressed">#4722D3EE</color>
+    <color name="raven_key_on">#2922D3EE</color>
+    <color name="raven_key_text">#FFF0F9FF</color>
+    <color name="raven_key_text_dim">#FFBAE6FD</color>
+    <color name="raven_key_hint">#FF7FA3C4</color>
+    <color name="raven_accent">#FF22D3EE</color>
+    <!-- Enter key fill. Deeper than the accent because the enter icon is white. -->
+    <color name="raven_action_key">#FF0E7490</color>
+    <color name="raven_action_key_pressed">#FF155E75</color>
+    <color name="raven_preview">#F51E2952</color>
+    <color name="raven_preview_stroke">#29BAE6FD</color>
+    <color name="raven_suggestion_pressed">#1FFFFFFF</color>
+
+    <dimen name="raven_key_radius">8dp</dimen>
+    <dimen name="raven_key_gap">2dp</dimen>
+</resources>
