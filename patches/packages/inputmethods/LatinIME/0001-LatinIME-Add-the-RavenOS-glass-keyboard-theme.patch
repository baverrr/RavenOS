diff --git a/java/res/drawable/raven_key.xml b/java/res/drawable/raven_key.xml
new file mode 100644
index 0000000..8020fda
--- /dev/null
+++ b/java/res/drawable/raven_key.xml
@@ -0,0 +1,20 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: 2026 RavenOS
+     SPDX-License-Identifier: Apache-2.0
+-->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <!-- Action keys. -->
+    <item android:state_active="true" android:state_pressed="true" android:drawable="@drawable/raven_key_action_pressed" />
+    <item android:state_active="true" android:drawable="@drawable/raven_key_action" />
+    <!-- Toggle keys. -->
+    <item android:state_checkable="true" android:state_pressed="true" android:drawable="@drawable/raven_key_pressed" />
+    <item android:state_checkable="true" android:state_checked="true" android:drawable="@drawable/raven_key_on" />
+    <item android:state_checkable="true" android:drawable="@drawable/raven_key_functional_normal" />
+    <!-- Empty background keys. -->
+    <item android:state_empty="true" android:state_pressed="true" android:drawable="@drawable/raven_key_pressed" />
+    <item android:state_empty="true" android:drawable="@android:color/transparent" />
+    <!-- Normal keys. -->
+    <item android:state_pressed="true" android:drawable="@drawable/raven_key_pressed" />
+    <item android:drawable="@drawable/raven_key_normal" />
+</selector>
