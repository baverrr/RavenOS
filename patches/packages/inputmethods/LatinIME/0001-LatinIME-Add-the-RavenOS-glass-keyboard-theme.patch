diff --git a/java/res/drawable/raven_keyboard_background.xml b/java/res/drawable/raven_keyboard_background.xml
new file mode 100644
index 0000000..68031f9
--- /dev/null
+++ b/java/res/drawable/raven_keyboard_background.xml
@@ -0,0 +1,26 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: 2026 RavenOS
+     SPDX-License-Identifier: Apache-2.0
+-->
+<!-- The bottom band of the Settings backdrop. Gradient radii are relative to the keyboard's
+     height, which is about 40% of the screen, so they are 2.5x the Settings values. -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <item>
+        <color android:color="@color/raven_bg" />
+    </item>
+    <item>
+        <shape android:dither="true">
+            <gradient android:type="radial" android:centerX="0.15" android:centerY="0.75"
+                android:gradientRadius="200%p"
+                android:startColor="@color/raven_glow_1" android:endColor="#00000000" />
+        </shape>
+    </item>
+    <item>
+        <shape android:dither="true">
+            <gradient android:type="radial" android:centerX="0.8" android:centerY="-1.1"
+                android:gradientRadius="190%p"
+                android:startColor="@color/raven_glow_2" android:endColor="#00000000" />
+        </shape>
+    </item>
+</layer-list>
