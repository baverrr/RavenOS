diff --git a/java/res/values/themes-raven-glass.xml b/java/res/values/themes-raven-glass.xml
new file mode 100644
index 0000000..ea0c20f
--- /dev/null
+++ b/java/res/values/themes-raven-glass.xml
@@ -0,0 +1,131 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: 2026 RavenOS
+     SPDX-License-Identifier: Apache-2.0
+-->
+<!-- RavenOS glass keyboard. Built on the LXX dark theme (layouts, icons, sizes) with glass key
+     backgrounds and colors from raven_glass.xml. -->
+<resources xmlns:android="http://schemas.android.com/apk/res/android">
+    <style name="KeyboardTheme.Raven_Glass" parent="KeyboardIcons.LXX_Dark">
+        <item name="inputViewStyle">@style/InputView.LXX</item>
+        <item name="keyboardStyle">@style/Keyboard.Raven_Glass</item>
+        <item name="keyboardViewStyle">@style/KeyboardView.Raven_Glass</item>
+        <item name="mainKeyboardViewStyle">@style/MainKeyboardView.Raven_Glass</item>
+        <item name="emojiPalettesViewStyle">@style/EmojiPalettesView.Raven_Glass</item>
+        <item name="moreKeysKeyboardStyle">@style/MoreKeysKeyboard.Raven_Glass</item>
+        <item name="moreKeysKeyboardViewStyle">@style/MoreKeysKeyboardView.Raven_Glass</item>
+        <item name="moreKeysKeyboardViewForActionStyle">@style/MoreKeysKeyboardView.Raven_Glass.Action</item>
+        <item name="suggestionStripViewStyle">@style/SuggestionStripView.Raven_Glass</item>
+        <item name="suggestionWordStyle">@style/SuggestionWord.Raven_Glass</item>
+    </style>
+    <style
+        name="Keyboard.Raven_Glass"
+        parent="Keyboard"
+    >
+        <!-- This should be aligned with KeyboardTheme.THEME_ID_* -->
+        <item name="themeId">RavenGlass</item>
+    </style>
+    <style
+        name="KeyboardView.Raven_Glass"
+        parent="KeyboardView.LXX"
+    >
+        <item name="android:background">@drawable/raven_keyboard_background</item>
+        <item name="keyBackground">@drawable/raven_key</item>
+        <item name="functionalKeyBackground">@drawable/raven_key_functional</item>
+        <item name="spacebarBackground">@drawable/raven_spacebar</item>
+        <item name="keyTextColor">@color/raven_key_text</item>
+        <item name="keyTextInactivatedColor">@color/raven_key_hint</item>
+        <item name="functionalTextColor">@color/raven_key_text</item>
+        <item name="keyHintLetterColor">@color/raven_key_hint</item>
+        <item name="keyHintLabelColor">@color/raven_key_hint</item>
+        <item name="keyShiftedLetterHintInactivatedColor">@color/raven_key_hint</item>
+        <item name="keyShiftedLetterHintActivatedColor">@color/raven_key_text</item>
+        <item name="keyPreviewTextColor">@color/raven_key_text</item>
+    </style>
+    <style
+        name="MainKeyboardView.Raven_Glass"
+        parent="KeyboardView.Raven_Glass"
+    >
+        <item name="moreKeysKeyboardForActionLayout">@layout/more_keys_keyboard_for_action_lxx</item>
+        <item name="keyPreviewBackground">@drawable/raven_key_preview</item>
+        <item name="keyPreviewHeight">@dimen/config_key_preview_height_lxx</item>
+        <item name="keyPreviewOffset">@dimen/config_key_preview_offset_lxx</item>
+        <item name="keyPreviewShowUpAnimator">@anim/key_preview_show_up_lxx</item>
+        <item name="keyPreviewDismissAnimator">@anim/key_preview_dismiss_lxx</item>
+        <item name="gestureFloatingPreviewTextColor">@color/raven_key_text</item>
+        <item name="gestureFloatingPreviewColor">@color/raven_preview</item>
+        <item name="gestureTrailColor">@color/raven_accent</item>
+        <item name="slidingKeyInputPreviewColor">@color/raven_key_pressed</item>
+        <item name="languageOnSpacebarTextColor">@color/raven_key_hint</item>
+        <!-- A negative value to disable text shadow layer. -->
+        <item name="languageOnSpacebarTextShadowRadius">-1.0</item>
+    </style>
+    <!-- The emoji page keeps the LXX dark category icons and only takes the glass keys and
+         backdrop. -->
+    <style
+        name="EmojiPalettesView.Raven_Glass"
+        parent="EmojiPalettesView.LXX_Dark"
+    >
+        <item name="android:background">@drawable/raven_keyboard_background</item>
+        <item name="keyBackground">@drawable/raven_key</item>
+        <item name="functionalKeyBackground">@drawable/raven_key_functional</item>
+        <item name="spacebarBackground">@drawable/raven_spacebar</item>
+        <item name="keyTextColor">@color/raven_key_text</item>
+        <item name="functionalTextColor">@color/raven_key_text</item>
+        <item name="categoryPageIndicatorColor">@color/raven_accent</item>
+        <item name="categoryPageIndicatorBackground">@color/raven_bg</item>
+    </style>
+    <style
+        name="MoreKeysKeyboard.Raven_Glass"
+        parent="Keyboard.Raven_Glass"
+    >
+        <item name="keyboardTopPadding">0%p</item>
+        <item name="keyboardBottomPadding">0%p</item>
+        <item name="horizontalGap">0%p</item>
+        <item name="touchPositionCorrectionData">@null</item>
+    </style>
+    <style
+        name="MoreKeysKeyboardView.Raven_Glass"
+        parent="KeyboardView.Raven_Glass"
+    >
+        <item name="android:background">@drawable/raven_popup_panel</item>
+        <item name="keyBackground">@drawable/raven_key_popup</item>
+        <item name="divider">@null</item>
+        <item name="keyTypeface">normal</item>
+        <item name="verticalCorrection">@dimen/config_more_keys_keyboard_vertical_correction_holo</item>
+    </style>
+    <style
+        name="MoreKeysKeyboardView.Raven_Glass.Action"
+        parent="MoreKeysKeyboardView.Raven_Glass"
+    >
+        <item name="android:background">@android:color/transparent</item>
+        <item name="keyBackground">@drawable/raven_key_popup_action</item>
+        <item name="keyLabelFlags">keepBackgroundAspectRatio</item>
+    </style>
+    <style
+        name="SuggestionStripView.Raven_Glass"
+        parent="KeyboardView.Raven_Glass"
+    >
+        <item name="suggestionsCountInStrip">@integer/config_suggestions_count_in_strip</item>
+        <item name="centerSuggestionPercentile">@fraction/config_center_suggestion_percentile</item>
+        <item name="maxMoreSuggestionsRow">@integer/config_max_more_suggestions_row</item>
+        <item name="minMoreSuggestionsWidth">@fraction/config_min_more_suggestions_width</item>
+        <!-- The top of the keyboard backdrop is close to plain raven_bg, so a flat fill meets
+             it without a visible edge. -->
+        <item name="android:background">@color/raven_bg</item>
+        <item name="android:src">@drawable/suggestions_strip_divider_lxx_dark</item>
+        <item name="suggestionStripOptions">autoCorrectBold|validTypedWordBold</item>
+        <item name="colorValidTypedWord">@color/raven_key_text</item>
+        <item name="colorTypedWord">@color/raven_key_text</item>
+        <item name="colorAutoCorrect">@color/raven_key_text</item>
+        <item name="colorSuggested">@color/raven_key_text_dim</item>
+        <item name="alphaObsoleted">70%</item>
+    </style>
+    <style
+        name="SuggestionWord.Raven_Glass"
+        parent="SuggestionWord"
+    >
+        <item name="android:background">@drawable/raven_suggestion</item>
+        <item name="android:textColor">@color/raven_accent</item>
+    </style>
+</resources>
