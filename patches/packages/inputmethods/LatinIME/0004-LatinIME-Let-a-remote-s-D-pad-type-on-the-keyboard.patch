+    /**
+     * RavenOS: lets a remote type on the keyboard. The arrows move a focused key and
+     * DPAD_CENTER types it, as a tap would; a key's long-press popup is not opened.
+     *
+     * @return whether the key was used
+     */
+    public boolean onRemoteKeyDown(final KeyEvent event) {
+        if (getKeyboard() == null || !isShown()) {
+            return false;
+        }
+        if (event.getKeyCode() == KeyEvent.KEYCODE_DPAD_CENTER) {
+            // Like the arrows, the first press only shows the focus.
+            final boolean wasVisible = mRemoteFocus.isVisible();
+            final Key key = mRemoteFocus.show();
+            if (wasVisible && key != null && event.getRepeatCount() == 0) {
+                typeKey(key);
+            }
+            invalidate();
+            return true;
+        }
+        if (mRemoteFocus.move(event.getKeyCode())) {
+            invalidate();
+            return true;
+        }
+        return false;
+    }
+
+    /** Starts the next keyboard with the remote's focus on its first letter. */
+    public void resetRemoteFocus() {
+        mRemoteFocus.reset();
+        invalidate();
+    }
+
+    private void typeKey(final Key key) {
+        final KeyboardActionListener listener = mKeyboardActionListener;
+        if (listener == null) {
+            return;
+        }
+        final int code = key.getCode();
+        listener.onPressKey(code, 0 /* repeatCount */, true /* isSinglePointer */);
+        if (code == Constants.CODE_OUTPUT_TEXT) {
+            listener.onTextInput(key.getOutputText());
+        } else if (code != Constants.CODE_UNSPECIFIED) {
+            listener.onCodeInput(code, Constants.NOT_A_COORDINATE, Constants.NOT_A_COORDINATE,
+                    false /* isKeyRepeat */);
+        }
+        listener.onReleaseKey(code, false /* withSliding */);
+    }
+
+    @Override
+    protected void onDraw(final Canvas canvas) {
+        super.onDraw(canvas);
+        mRemoteFocus.draw(canvas, getPaddingLeft(), getPaddingTop());
+    }
+
     public boolean isInDoubleTapShiftKeyTimeout() {
         return mTimerHandler.isInDoubleTapShiftKeyTimeout();
     }
