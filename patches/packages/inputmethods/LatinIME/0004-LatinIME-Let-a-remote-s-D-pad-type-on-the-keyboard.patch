diff --git a/java/src/com/android/inputmethod/keyboard/RemoteKeyFocus.java b/java/src/com/android/inputmethod/keyboard/RemoteKeyFocus.java
new file mode 100644
index 0000000..489b441
--- /dev/null
+++ b/java/src/com/android/inputmethod/keyboard/RemoteKeyFocus.java
@@ -0,0 +1,206 @@
+/*
+ * SPDX-FileCopyrightText: 2026 RavenOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.inputmethod.keyboard;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.view.KeyEvent;
+
+import com.android.inputmethod.latin.R;
+
+/**
+ * The key a remote's D-pad points at. The arrows move it to the nearest key in that direction
+ * and the owner types it on DPAD_CENTER. It is only drawn after a remote key was used, and
+ * hidden again on touch, so touch typing looks the same as before.
+ */
+final class RemoteKeyFocus {
+    /** Alpha of the accent fill behind the focused key. */
+    private static final int FILL_ALPHA = 0x29;
+
+    private final Paint mFillPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mStrokePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final float mRadius;
+    private final RectF mRect = new RectF();
+
+    private Keyboard mKeyboard;
+    private Key mKey;
+    private boolean mVisible;
+
+    RemoteKeyFocus(final Context context) {
+        final float density = context.getResources().getDisplayMetrics().density;
+        final int accent = context.getColor(R.color.raven_accent);
+        mFillPaint.setColor((FILL_ALPHA << 24) | (accent & 0xFFFFFF));
+        mStrokePaint.setColor(accent);
+        mStrokePaint.setStyle(Paint.Style.STROKE);
+        mStrokePaint.setStrokeWidth(2 * density);
+        mRadius = context.getResources().getDimension(R.dimen.raven_key_radius);
+    }
+
+    /**
+     * Follows a layout change (shift, symbols, a new field): the focus stays on the key nearest
+     * to where it was, or starts on the first letter.
+     */
+    void setKeyboard(final Keyboard keyboard) {
+        final Key previous = mKey;
+        mKeyboard = keyboard;
+        mKey = null;
+        if (keyboard == null) {
+            return;
+        }
+        mKey = previous != null ? nearest(centerX(previous), centerY(previous))
+                : firstLetter();
+    }
+
+    /** Starts the next keyboard on its first letter, and hides the focus until a remote key. */
+    void reset() {
+        mKey = null;
+        mVisible = false;
+        if (mKeyboard != null) {
+            mKey = firstLetter();
+        }
+    }
+
+    void hide() {
+        mVisible = false;
+    }
+
+    boolean isVisible() {
+        return mVisible;
+    }
+
+    /** The focused key, made visible; null if the keyboard has no keys. */
+    Key show() {
+        mVisible = true;
+        return mKey;
+    }
+
+    /** Moves the focus for an arrow key. Returns false for any other key. */
+    boolean move(final int keyCode) {
+        if (keyCode != KeyEvent.KEYCODE_DPAD_UP && keyCode != KeyEvent.KEYCODE_DPAD_DOWN
+                && keyCode != KeyEvent.KEYCODE_DPAD_LEFT
+                && keyCode != KeyEvent.KEYCODE_DPAD_RIGHT) {
+            return false;
+        }
+        final boolean wasVisible = mVisible;
+        if (show() == null || !wasVisible) {
+            // The first press only shows where the focus is.
+            return true;
+        }
+        final Key next = next(keyCode);
+        if (next != null) {
+            mKey = next;
+        }
+        return true;
+    }
+
+    void draw(final Canvas canvas, final int paddingLeft, final int paddingTop) {
+        if (!mVisible || mKey == null) {
+            return;
+        }
+        final float inset = mStrokePaint.getStrokeWidth() / 2;
+        final float left = paddingLeft + mKey.getDrawX() + inset;
+        final float top = paddingTop + mKey.getY() + inset;
+        mRect.set(left, top, left + mKey.getDrawWidth() - 2 * inset,
+                top + mKey.getHeight() - 2 * inset);
+        canvas.drawRoundRect(mRect, mRadius, mRadius, mFillPaint);
+        canvas.drawRoundRect(mRect, mRadius, mRadius, mStrokePaint);
+    }
+
+    private Key next(final int keyCode) {
+        final int x = centerX(mKey);
+        final int y = centerY(mKey);
+        final int halfHeight = mKey.getHeight() / 2;
+        final boolean vertical = keyCode == KeyEvent.KEYCODE_DPAD_UP
+                || keyCode == KeyEvent.KEYCODE_DPAD_DOWN;
+        final int sign = keyCode == KeyEvent.KEYCODE_DPAD_UP
+                || keyCode == KeyEvent.KEYCODE_DPAD_LEFT ? -1 : 1;
+        // Up/down: the nearest row in that direction, then the key closest horizontally.
+        // Left/right: the closest key in the same row.
+        int bestRow = Integer.MAX_VALUE;
+        if (vertical) {
+            for (final Key key : mKeyboard.getSortedKeys()) {
+                final int dy = (centerY(key) - y) * sign;
+                if (isFocusable(key) && dy > halfHeight) {
+                    bestRow = Math.min(bestRow, dy);
+                }
+            }
+        }
+        Key best = null;
+        int bestDistance = Integer.MAX_VALUE;
+        for (final Key key : mKeyboard.getSortedKeys()) {
+            if (!isFocusable(key) || key == mKey) {
+                continue;
+            }
+            final int dx = centerX(key) - x;
+            final int dy = centerY(key) - y;
+            final int distance;
+            if (vertical) {
+                if (dy * sign <= halfHeight || dy * sign > bestRow + halfHeight / 2) {
+                    continue;
+                }
+                distance = Math.abs(dx);
+            } else {
+                if (Math.abs(dy) >= halfHeight || dx * sign <= 0) {
+                    continue;
+                }
+                distance = Math.abs(dx);
+            }
+            if (distance < bestDistance) {
+                best = key;
+                bestDistance = distance;
+            }
+        }
+        return best;
+    }
+
+    private Key firstLetter() {
+        Key first = null;
+        for (final Key key : mKeyboard.getSortedKeys()) {
+            if (!isFocusable(key)) {
+                continue;
+            }
+            if (Character.isLetter(key.getCode())) {
+                return key;
+            }
+            if (first == null) {
+                first = key;
+            }
+        }
+        return first;
+    }
+
+    private Key nearest(final int x, final int y) {
+        Key best = null;
+        long bestDistance = Long.MAX_VALUE;
+        for (final Key key : mKeyboard.getSortedKeys()) {
+            if (!isFocusable(key)) {
+                continue;
+            }
+            final long dx = centerX(key) - x;
+            final long dy = centerY(key) - y;
+            final long distance = dx * dx + dy * dy;
+            if (distance < bestDistance) {
+                best = key;
+                bestDistance = distance;
+            }
+        }
+        return best;
+    }
+
+    private static boolean isFocusable(final Key key) {
+        return !key.isSpacer() && key.isEnabled();
+    }
+
+    private static int centerX(final Key key) {
+        return key.getDrawX() + key.getDrawWidth() / 2;
+    }
+
+    private static int centerY(final Key key) {
+        return key.getY() + key.getHeight() / 2;
+    }
+}
