+/*
+ * SPDX-FileCopyrightText: 2026 RavenOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.widget;
+
+import android.view.View;
+import android.view.ViewGroup;
+
+/**
+ * Makes a scrolling list end cleanly on the glass backdrop. Theme.Settings turns off child
+ * clipping, so rows and cards used to draw past the list into the transparent navigation bar
+ * and under the action bar, looking sliced. The list is clipped to its own bounds instead, and
+ * content that continues past an edge fades out over the last 48dp.
+ */
+public final class ListEdges {
+
+    private static final int FADE_DP = 48;
+
+    private ListEdges() {
+    }
+
+    public static void apply(View list) {
+        if (list instanceof ViewGroup) {
+            ((ViewGroup) list).setClipChildren(true);
+        }
+        if (list.getParent() instanceof ViewGroup) {
+            // Also clips what the list draws itself, such as the glass cards.
+            ((ViewGroup) list.getParent()).setClipChildren(true);
+        }
+        list.setVerticalFadingEdgeEnabled(true);
+        list.setFadingEdgeLength(Math.round(FADE_DP * list.getResources()
+                .getDisplayMetrics().density));
+    }
+}
