From 60463f9d4dfdb1c49932a7f10b155d921d417f13 Mon Sep 17 00:00:00 2001
From: baverrr <342259467+baverrr@users.noreply.github.com>
Date: Mon, 2 Nov 2026 20:01:27 -0700
Subject: [PATCH] Settings: Allow hiding the Accounts entry

Add config_show_top_level_accounts (default true), like the other
config_show_top_level_* flags. When a product overlay sets it to false,
the Accounts entry on the homepage is marked unsupported and the
Accounts page is left out of search. RavenOS uses this because it ships
no account authenticators, so "Add account" has nothing to offer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: If9e6128f79f3039f0582ebcd9c32605c9777777a
---
 res/values/config.xml                                       | 3 +++
 .../android/settings/accounts/AccountDashboardFragment.java | 6 ++++++
 .../accounts/TopLevelAccountEntryPreferenceController.java  | 3 ++-
 3 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/res/values/config.xml b/res/values/config.xml
index 8e15bfc..35b8771 100755
--- a/res/values/config.xml
+++ b/res/values/config.xml
@@ -410,6 +410,9 @@
     <!-- Whether top_level_accessibility should be shown or not. -->
     <bool name="config_show_top_level_accessibility">true</bool>
 
+    <!-- Whether top_level_accounts should be shown or not. -->
+    <bool name="config_show_top_level_accounts">true</bool>
+
     <!-- Whether top_level_battery should be shown or not. -->
     <bool name="config_show_top_level_battery">true</bool>
 
diff --git a/src/com/android/settings/accounts/AccountDashboardFragment.java b/src/com/android/settings/accounts/AccountDashboardFragment.java
index c66b6c7..cb2e9dc 100644
--- a/src/com/android/settings/accounts/AccountDashboardFragment.java
+++ b/src/com/android/settings/accounts/AccountDashboardFragment.java
@@ -97,6 +97,12 @@ public class AccountDashboardFragment extends DashboardFragment {
     public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
             new BaseSearchIndexProvider(R.xml.accounts_dashboard_settings) {
 
+                @Override
+                protected boolean isPageSearchEnabled(Context context) {
+                    return context.getResources().getBoolean(
+                            R.bool.config_show_top_level_accounts);
+                }
+
                 @Override
                 public List<AbstractPreferenceController> createPreferenceControllers(
                         Context context) {
diff --git a/src/com/android/settings/accounts/TopLevelAccountEntryPreferenceController.java b/src/com/android/settings/accounts/TopLevelAccountEntryPreferenceController.java
index e4e32e5..757ac4b 100644
--- a/src/com/android/settings/accounts/TopLevelAccountEntryPreferenceController.java
+++ b/src/com/android/settings/accounts/TopLevelAccountEntryPreferenceController.java
@@ -36,7 +36,8 @@ public class TopLevelAccountEntryPreferenceController extends BasePreferenceCont
 
     @Override
     public int getAvailabilityStatus() {
-        return AVAILABLE;
+        return mContext.getResources().getBoolean(R.bool.config_show_top_level_accounts)
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
     }
 
     @Override
-- 
2.53.0

