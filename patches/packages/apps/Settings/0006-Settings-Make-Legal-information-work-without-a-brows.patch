diff --git a/src/com/android/settings/LegalSettings.java b/src/com/android/settings/LegalSettings.java
index 93abf94..5d61ec4 100644
--- a/src/com/android/settings/LegalSettings.java
+++ b/src/com/android/settings/LegalSettings.java
@@ -17,16 +17,25 @@
 package com.android.settings;
 
 import android.app.settings.SettingsEnums;
+import android.content.ActivityNotFoundException;
+import android.content.Context;
 import android.content.Intent;
 import android.net.Uri;
 import android.os.SystemProperties;
 import android.util.Log;
+import androidx.core.content.FileProvider;
 import androidx.preference.Preference;
 
 import com.android.settings.dashboard.DashboardFragment;
 import com.android.settings.search.BaseSearchIndexProvider;
 import com.android.settingslib.search.SearchIndexable;
 
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+
 @SearchIndexable
 public class LegalSettings extends DashboardFragment {
 
@@ -52,6 +61,11 @@ public class LegalSettings extends DashboardFragment {
             final Intent intent = new Intent(Intent.ACTION_VIEW);
             intent.addCategory(Intent.CATEGORY_DEFAULT);
             intent.setData(Uri.parse(userLineageLicenseUrl));
+            if (intent.resolveActivity(getContext().getPackageManager()) == null) {
+                // RavenOS ships no browser, so show the copy bundled in res/raw instead.
+                showOfflineLineageLicense();
+                return true;
+            }
             try {
                 startActivity(intent);
             } catch (Exception e) {
@@ -61,6 +75,36 @@ public class LegalSettings extends DashboardFragment {
         return super.onPreferenceTreeClick(preference);
     }
 
+    private void showOfflineLineageLicense() {
+        final Context context = getContext();
+        // HTMLViewer only opens content:// URIs, so share the copy through our FileProvider.
+        final File file = new File(context.getCacheDir(), "lineage_legal.html");
+        try (InputStream in = context.getResources().openRawResource(R.raw.lineage_legal);
+                OutputStream out = new FileOutputStream(file)) {
+            final byte[] buffer = new byte[8 * 1024];
+            int count;
+            while ((count = in.read(buffer)) > 0) {
+                out.write(buffer, 0, count);
+            }
+        } catch (IOException e) {
+            Log.e(TAG, "Unable to copy the LineageOS legal page", e);
+            return;
+        }
+        final Intent intent = new Intent(Intent.ACTION_VIEW);
+        intent.setDataAndType(
+                FileProvider.getUriForFile(context, Utils.FILE_PROVIDER_AUTHORITY, file),
+                "text/html");
+        intent.putExtra(Intent.EXTRA_TITLE, getString(R.string.lineagelicense_title));
+        intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+        intent.addCategory(Intent.CATEGORY_DEFAULT);
+        intent.setPackage("com.android.htmlviewer");
+        try {
+            startActivity(intent);
+        } catch (ActivityNotFoundException e) {
+            Log.e(TAG, "Unable to show the LineageOS legal page", e);
+        }
+    }
+
     @Override
     protected int getPreferenceScreenResId() {
         return R.xml.about_legal;
diff --git a/src/com/android/settings/SettingsLicenseActivity.java b/src/com/android/settings/SettingsLicenseActivity.java
index 57b1f5c..53ecffd 100644
--- a/src/com/android/settings/SettingsLicenseActivity.java
+++ b/src/com/android/settings/SettingsLicenseActivity.java
@@ -33,6 +33,12 @@ import androidx.loader.content.Loader;
 import com.android.settingslib.license.LicenseHtmlLoaderCompat;
 
 import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.zip.GZIPInputStream;
 
 /**
  * The "dialog" that shows from "License" in the Settings app.
@@ -51,7 +57,16 @@ public class SettingsLicenseActivity extends FragmentActivity implements
 
         File file = new File(LICENSE_PATH);
         if (isFileValid(file)) {
-            showHtmlFromUri(Uri.fromFile(file));
+            // HTMLViewer only opens content:// URIs, and only unzips file:// ones, so unzip the
+            // notice into the cache our FileProvider shares and hand it over from there.
+            new Thread(() -> {
+                final File html = unzipLicense(file);
+                runOnUiThread(() -> {
+                    if (!isFinishing() && !isDestroyed()) {
+                        showGeneratedHtmlFile(html);
+                    }
+                });
+            }).start();
         } else {
             showHtmlFromDefaultXmlFiles();
         }
@@ -71,6 +86,23 @@ public class SettingsLicenseActivity extends FragmentActivity implements
     public void onLoaderReset(Loader<File> loader) {
     }
 
+    private File unzipLicense(File gzipFile) {
+        final File htmlFile = new File(getCacheDir(), "NOTICE.html");
+        try (InputStream in = new GZIPInputStream(new FileInputStream(gzipFile));
+                OutputStream out = new FileOutputStream(htmlFile)) {
+            final byte[] buffer = new byte[64 * 1024];
+            int count;
+            while ((count = in.read(buffer)) > 0) {
+                out.write(buffer, 0, count);
+            }
+            return htmlFile;
+        } catch (IOException e) {
+            Log.e(TAG, "Failed to unzip " + gzipFile, e);
+            htmlFile.delete();
+            return null;
+        }
+    }
+
     private void showHtmlFromDefaultXmlFiles() {
         getSupportLoaderManager().initLoader(LOADER_ID_LICENSE_HTML_LOADER, Bundle.EMPTY, this);
     }
