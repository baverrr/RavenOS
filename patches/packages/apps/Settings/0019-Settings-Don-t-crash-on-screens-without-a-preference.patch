From e1ae29c2c09b6ec78b5beb35989ba4d6e31e2ce3 Mon Sep 17 00:00:00 2001
From: baverrr <342259467+baverrr@users.noreply.github.com>
Date: Tue, 3 Nov 2026 23:49:47 -0700
Subject: [PATCH 19/22] Settings: Don't crash on screens without a preference
 list

Screens whose fragment inflates its own layout have no preference list, so adding the glass card decoration threw a NullPointerException. Settings closed right after a new screen lock was saved (RedactionInterstitial), and in Running services and ConfirmConvertToFbe.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I3fc104c182881ad71a86c52a721d3c6de9636109
---
 .../android/settings/SettingsPreferenceFragment.java | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/src/com/android/settings/SettingsPreferenceFragment.java b/src/com/android/settings/SettingsPreferenceFragment.java
index 60fe670..142a496 100644
--- a/src/com/android/settings/SettingsPreferenceFragment.java
+++ b/src/com/android/settings/SettingsPreferenceFragment.java
@@ -207,10 +207,16 @@ public abstract class SettingsPreferenceFragment extends InstrumentedPreferenceF
     @Override
     public void onViewCreated(View view, Bundle savedInstanceState) {
         super.onViewCreated(view, savedInstanceState);
-        // RavenOS: preferences sit in glass cards, which draw their own separators.
+        // RavenOS: preferences sit in glass cards, which draw their own separators. Fragments
+        // that inflate their own layout in onCreateView (RedactionInterstitial, RunningServices,
+        // ConfirmConvertToFbe) have no preference list, so leave them alone.
+        final RecyclerView list = getListView();
+        if (list == null) {
+            return;
+        }
         setDivider(null);
-        new GlassGroupDecoration(getContext(), getGlassGroupStartKeys()).attachTo(getListView());
-        ListEdges.apply(getListView());
+        new GlassGroupDecoration(getContext(), getGlassGroupStartKeys()).attachTo(list);
+        ListEdges.apply(list);
     }
 
     /**
