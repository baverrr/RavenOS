diff --git a/src/com/android/settings/widget/GlassGroupDecoration.java b/src/com/android/settings/widget/GlassGroupDecoration.java
new file mode 100644
index 0000000..b309f7c
--- /dev/null
+++ b/src/com/android/settings/widget/GlassGroupDecoration.java
@@ -0,0 +1,192 @@
+/*
+ * SPDX-FileCopyrightText: 2026 RavenOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.widget;
+
+import android.content.Context;
+import android.content.res.Resources;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.view.View;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.PreferenceGroupAdapter;
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.android.settings.R;
+import com.android.settingslib.widget.FooterPreference;
+
+import java.util.Collections;
+import java.util.Set;
+
+/**
+ * Draws each run of preferences between category headers as one rounded glass card, with
+ * hairline separators inset to the title, and keeps the list in a centred column on wide
+ * screens. Category titles and footers sit outside the cards.
+ */
+public class GlassGroupDecoration extends RecyclerView.ItemDecoration {
+
+    private final Set<String> mGroupStartKeys;
+    private final Paint mFillPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mStrokePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mSeparatorPaint = new Paint();
+    private final float mRadius;
+    private final float mStrokeWidth;
+    private final int mGroupGap;
+    private final RectF mRun = new RectF();
+
+    public GlassGroupDecoration(Context context) {
+        this(context, Collections.emptySet());
+    }
+
+    /**
+     * @param groupStartKeys keys of preferences that start a new card even without a category
+     *                       above them, for screens such as the homepage that have no categories
+     */
+    public GlassGroupDecoration(Context context, Set<String> groupStartKeys) {
+        final Resources res = context.getResources();
+        mGroupStartKeys = groupStartKeys;
+        mRadius = res.getDimension(R.dimen.raven_card_radius);
+        mStrokeWidth = res.getDisplayMetrics().density;
+        mGroupGap = res.getDimensionPixelSize(R.dimen.raven_group_gap);
+        mFillPaint.setColor(context.getColor(R.color.raven_glass));
+        mStrokePaint.setColor(context.getColor(R.color.raven_glass_stroke));
+        mStrokePaint.setStyle(Paint.Style.STROKE);
+        mStrokePaint.setStrokeWidth(mStrokeWidth);
+        mSeparatorPaint.setColor(context.getColor(R.color.raven_separator));
+    }
+
+    /** Adds the decoration to {@code list} and keeps its column width in step with the list. */
+    public void attachTo(RecyclerView list) {
+        list.addItemDecoration(this);
+        list.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, or, ob) -> {
+            if (r - l != or - ol) {
+                list.invalidateItemDecorations();
+            }
+        });
+    }
+
+    /** Side margin that centres content in a column no wider than raven_content_max_width. */
+    public static int getSideInset(Context context, int width) {
+        final Resources res = context.getResources();
+        final int maxWidth = res.getDimensionPixelSize(R.dimen.raven_content_max_width);
+        final int minSide = res.getDimensionPixelSize(R.dimen.raven_content_min_side);
+        return Math.max(minSide, (width - maxWidth) / 2);
+    }
+
+    @Override
+    public void getItemOffsets(Rect outRect, View view, RecyclerView parent,
+            RecyclerView.State state) {
+        final int position = parent.getChildAdapterPosition(view);
+        final Preference preference = getItem(parent, position);
+        if (preference == null) {
+            return;
+        }
+        final int side = getSideInset(parent.getContext(), parent.getWidth());
+        outRect.left = side;
+        outRect.right = side;
+        if (isCard(preference) && endsGroup(parent, position)) {
+            outRect.bottom = mGroupGap;
+        }
+    }
+
+    @Override
+    public void onDraw(Canvas canvas, RecyclerView parent, RecyclerView.State state) {
+        boolean inRun = false;
+        final int count = parent.getChildCount();
+        for (int i = 0; i < count; i++) {
+            final View child = parent.getChildAt(i);
+            final int position = parent.getChildAdapterPosition(child);
+            final Preference preference = getItem(parent, position);
+            if (preference == null || !isCard(preference)) {
+                if (inRun) {
+                    // The rest of this group is not laid out yet; leave its bottom open.
+                    drawRun(canvas, false);
+                    inRun = false;
+                }
+                continue;
+            }
+            final float top = child.getTop() + child.getTranslationY();
+            final float bottom = child.getBottom() + child.getTranslationY();
+            final boolean first = startsGroup(parent, position);
+            if (first && inRun) {
+                drawRun(canvas, false);
+                inRun = false;
+            }
+            if (!inRun) {
+                // A group whose first rows have scrolled away keeps its top edge off-screen.
+                mRun.set(child.getLeft(), first ? top : top - 2 * mRadius,
+                        child.getRight(), bottom);
+                inRun = true;
+            } else {
+                mRun.bottom = bottom;
+                drawSeparator(canvas, child, top);
+            }
+            if (endsGroup(parent, position)) {
+                drawRun(canvas, true);
+                inRun = false;
+            }
+        }
+        if (inRun) {
+            drawRun(canvas, false);
+        }
+    }
+
+    private void drawRun(Canvas canvas, boolean closed) {
+        if (!closed) {
+            mRun.bottom += 2 * mRadius;
+        }
+        canvas.drawRoundRect(mRun, mRadius, mRadius, mFillPaint);
+        final float half = mStrokeWidth / 2;
+        canvas.drawRoundRect(mRun.left + half, mRun.top + half, mRun.right - half,
+                mRun.bottom - half, mRadius, mRadius, mStrokePaint);
+    }
+
+    private void drawSeparator(Canvas canvas, View child, float y) {
+        float start = child.getLeft();
+        final View title = child.findViewById(android.R.id.title);
+        if (title != null && title.getVisibility() == View.VISIBLE) {
+            int left = 0;
+            for (View v = title; v != child && v != null; v = (View) v.getParent()) {
+                left += v.getLeft();
+            }
+            start += left;
+        } else {
+            start += mRadius;
+        }
+        canvas.drawRect(start, y, child.getRight(), y + mStrokeWidth, mSeparatorPaint);
+    }
+
+    private boolean startsGroup(RecyclerView parent, int position) {
+        final Preference previous = getItem(parent, position - 1);
+        if (previous == null || !isCard(previous)) {
+            return true;
+        }
+        final Preference preference = getItem(parent, position);
+        return preference != null && mGroupStartKeys.contains(preference.getKey());
+    }
+
+    private boolean endsGroup(RecyclerView parent, int position) {
+        final Preference next = getItem(parent, position + 1);
+        return next == null || !isCard(next) || mGroupStartKeys.contains(next.getKey());
+    }
+
+    private static boolean isCard(Preference preference) {
+        return !(preference instanceof PreferenceCategory)
+                && !(preference instanceof FooterPreference);
+    }
+
+    private static Preference getItem(RecyclerView parent, int position) {
+        final RecyclerView.Adapter adapter = parent.getAdapter();
+        if (!(adapter instanceof PreferenceGroupAdapter)
+                || position < 0 || position >= adapter.getItemCount()) {
+            return null;
+        }
+        return ((PreferenceGroupAdapter) adapter).getItem(position);
+    }
+}
