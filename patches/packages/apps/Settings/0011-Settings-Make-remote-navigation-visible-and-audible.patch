+    @Override
+    public void onDrawOver(Canvas canvas, RecyclerView parent, RecyclerView.State state) {
+        final View focused = parent.getFocusedChild();
+        if (focused == null || !focused.isFocused()) {
+            return;
+        }
+        final int position = parent.getChildAdapterPosition(focused);
+        final Preference preference = getItem(parent, position);
+        if (preference == null || !isCard(preference)) {
+            return;
+        }
+        final float top = focused.getTop() + focused.getTranslationY();
+        mFocusRect.set(focused.getLeft() + mFocusInset, top + mFocusInset,
+                focused.getRight() - mFocusInset,
+                focused.getBottom() + focused.getTranslationY() - mFocusInset);
+        final float outer = mRadius - mFocusInset;
+        final float topRadius = startsGroup(parent, position) ? outer : mFocusInnerRadius;
+        final float bottomRadius = endsGroup(parent, position) ? outer : mFocusInnerRadius;
+        for (int i = 0; i < 4; i++) {
+            mFocusRadii[i] = topRadius;
+            mFocusRadii[i + 4] = bottomRadius;
+        }
+        mFocusPath.reset();
+        mFocusPath.addRoundRect(mFocusRect, mFocusRadii, Path.Direction.CW);
+        canvas.drawPath(mFocusPath, mFocusFillPaint);
+        canvas.drawPath(mFocusPath, mFocusStrokePaint);
     }
 
