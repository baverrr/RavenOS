--- /dev/null
+++ b/src/com/android/settings/widget/NavigationSound.java
@@ -0,0 +1,54 @@
+/*
+ * SPDX-FileCopyrightText: 2026 RavenOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.widget;
+
+import android.view.KeyEvent;
+import android.view.SoundEffectConstants;
+import android.view.View;
+import android.view.Window;
+
+/**
+ * Plays the navigation tick when a remote's arrow key moves focus inside a view that handles
+ * the key itself, such as a scroll view. The framework only plays it when it moves focus on
+ * its own, so without this those moves are silent.
+ */
+public final class NavigationSound {
+
+    private NavigationSound() {
+    }
+
+    /**
+     * Call from Activity.dispatchKeyEvent with the focus from before the key was dispatched
+     * and whether the window handled it.
+     */
+    public static void afterKey(Window window, KeyEvent event, View focusBefore,
+            boolean handled) {
+        if (!handled || event.getAction() != KeyEvent.ACTION_DOWN) {
+            return;
+        }
+        final int direction;
+        switch (event.getKeyCode()) {
+            case KeyEvent.KEYCODE_DPAD_UP:
+                direction = View.FOCUS_UP;
+                break;
+            case KeyEvent.KEYCODE_DPAD_DOWN:
+                direction = View.FOCUS_DOWN;
+                break;
+            case KeyEvent.KEYCODE_DPAD_LEFT:
+                direction = View.FOCUS_LEFT;
+                break;
+            case KeyEvent.KEYCODE_DPAD_RIGHT:
+                direction = View.FOCUS_RIGHT;
+                break;
+            default:
+                return;
+        }
+        final View focus = window.getCurrentFocus();
+        if (focus != null && focus != focusBefore) {
+            focus.playSoundEffect(SoundEffectConstants.getContantForFocusDirection(direction));
+        }
+    }
+}
