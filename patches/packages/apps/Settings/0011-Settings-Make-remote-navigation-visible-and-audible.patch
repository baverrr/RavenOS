+    private static void followScroll(View appBar, int scrollY) {
+        final int height = appBar.getHeight();
+        if (height == 0) {
+            return;
+        }
+        final int offset = Math.min(scrollY, height);
+        appBar.setTranslationY(-offset);
+        appBar.setAlpha(1f - (float) offset / height);
+        // Invisible once fully away, so a remote's focus doesn't land on it.
+        appBar.setVisibility(offset < height ? View.VISIBLE : View.INVISIBLE);
+    }
+
