From 6ec98bb4c67ef5e44934e77fa72c7b93194f45b4 Mon Sep 17 00:00:00 2001
From: baverrr <342259467+baverrr@users.noreply.github.com>
Date: Tue, 3 Nov 2026 08:46:45 -0700
Subject: [PATCH] PermissionController: Make the touch glow follow the finger
 faster

The glow now catches up with the finger in about 40 ms instead of 120 ms and fades in over 80 ms instead of 150 ms.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I5e0e6cb73c7ffa736cbd1c1de6b377743993779b
---
 src/com/android/permissioncontroller/GlowBackdrop.java | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/com/android/permissioncontroller/GlowBackdrop.java b/src/com/android/permissioncontroller/GlowBackdrop.java
index 9075d04..6cff2b7 100644
--- a/src/com/android/permissioncontroller/GlowBackdrop.java
+++ b/src/com/android/permissioncontroller/GlowBackdrop.java
@@ -42,8 +42,8 @@ import java.util.List;
 public class GlowBackdrop extends Drawable implements TimeAnimator.TimeListener {
 
     /** How quickly the glow catches up with the finger. */
-    private static final float FOLLOW_MILLIS = 120f;
-    private static final float FADE_IN_MILLIS = 150f;
+    private static final float FOLLOW_MILLIS = 40f;
+    private static final float FADE_IN_MILLIS = 80f;
     private static final float FADE_OUT_MILLIS = 600f;
     /** Glow radius as a fraction of the shorter screen side. */
     private static final float RADIUS_FRACTION = 0.45f;
-- 
2.53.0

