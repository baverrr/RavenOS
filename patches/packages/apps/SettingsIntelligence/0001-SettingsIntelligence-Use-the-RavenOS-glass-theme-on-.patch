diff --git a/res/drawable/raven_backdrop.xml b/res/drawable/raven_backdrop.xml
new file mode 100644
index 0000000..25b0440
--- /dev/null
+++ b/res/drawable/raven_backdrop.xml
@@ -0,0 +1,33 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: 2026 RavenOS
+     SPDX-License-Identifier: Apache-2.0
+-->
+<!-- Window backdrop behind every Settings page. Android 11 has no backdrop blur, so the
+     softness of the "glass" comes from these wide, already-blurred glows. -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <item>
+        <color android:color="@color/raven_bg" />
+    </item>
+    <item>
+        <shape android:dither="true">
+            <gradient android:type="radial" android:centerX="0.15" android:centerY="0.9"
+                android:gradientRadius="80%p"
+                android:startColor="@color/raven_glow_1" android:endColor="#00000000" />
+        </shape>
+    </item>
+    <item>
+        <shape android:dither="true">
+            <gradient android:type="radial" android:centerX="0.8" android:centerY="0.15"
+                android:gradientRadius="75%p"
+                android:startColor="@color/raven_glow_2" android:endColor="#00000000" />
+        </shape>
+    </item>
+    <item>
+        <shape android:dither="true">
+            <gradient android:type="radial" android:centerX="0.55" android:centerY="0.55"
+                android:gradientRadius="55%p"
+                android:startColor="@color/raven_glow_3" android:endColor="#00000000" />
+        </shape>
+    </item>
+</layer-list>
diff --git a/res/drawable/raven_glass_card.xml b/res/drawable/raven_glass_card.xml
new file mode 100644
index 0000000..f2859c3
--- /dev/null
+++ b/res/drawable/raven_glass_card.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: 2026 RavenOS
+     SPDX-License-Identifier: Apache-2.0
+-->
+<!-- Glass card behind the search results. -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android">
+    <solid android:color="@color/raven_glass" />
+    <stroke android:width="1dp" android:color="@color/raven_glass_stroke" />
+    <corners android:radius="@dimen/raven_card_radius" />
+</shape>
diff --git a/res/drawable/raven_search_outline.xml b/res/drawable/raven_search_outline.xml
new file mode 100644
index 0000000..0e9ac11
--- /dev/null
+++ b/res/drawable/raven_search_outline.xml
@@ -0,0 +1,10 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: 2026 RavenOS
+     SPDX-License-Identifier: Apache-2.0
+-->
