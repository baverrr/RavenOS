diff --git a/res/values/raven_glass.xml b/res/values/raven_glass.xml
new file mode 100644
index 0000000..86b4b01
--- /dev/null
+++ b/res/values/raven_glass.xml
@@ -0,0 +1,43 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: 2026 RavenOS
+     SPDX-License-Identifier: Apache-2.0
+-->
+<!-- RavenOS glass theme tokens. These are the Midnight Aurora values; the product picks a
+     variant by overlaying this file from vendor/ravenos/themes/<variant>/ (see THEME.md). -->
+<resources>
+    <!-- Backdrop: base fill and three soft glows. -->
+    <color name="raven_bg">#FF070B1D</color>
+    <color name="raven_glow_1">#CC0D9488</color>
+    <color name="raven_glow_2">#AA7C3AED</color>
+    <color name="raven_glow_3">#881E3A8A</color>
+
+    <!-- Text. -->
+    <color name="raven_fg">#FFF0F9FF</color>
+    <color name="raven_fg_2">#FFBAE6FD</color>
+    <color name="raven_fg_3">#FF7FA3C4</color>
+
+    <!-- Glass cards. -->
+    <color name="raven_glass">#12FFFFFF</color>
+    <color name="raven_glass_stroke">#29BAE6FD</color>
+    <color name="raven_separator">#1ABAE6FD</color>
+    <color name="raven_ripple">#1FFFFFFF</color>
+
+    <!-- Accent, and the switch bar when it is on. -->
+    <color name="raven_accent">#FF22D3EE</color>
+    <color name="raven_on_accent">#FF04212A</color>
+    <color name="raven_switchbar_on">#2922D3EE</color>
+    <color name="raven_switchbar_on_stroke">#7322D3EE</color>
+    <color name="raven_tab_selected">#29FFFFFF</color>
+
+    <!-- Solid surface for dialogs: no live blur on Android 11, so these stay opaque. -->
+    <color name="raven_surface">#FF141B33</color>
+
+    <!-- True for light variants: dark status bar icons and dark text. -->
+    <bool name="raven_light_ui">false</bool>
+
+    <dimen name="raven_card_radius">20dp</dimen>
+    <!-- Side margin that centres the search bar and results in the same column as the
+         Settings cards (at most 760dp wide). values-w900dp widens it. -->
+    <dimen name="raven_side_margin">16dp</dimen>
+</resources>
diff --git a/res/values/themes.xml b/res/values/themes.xml
index c0453b1..9cb7dde 100644
--- a/res/values/themes.xml
+++ b/res/values/themes.xml
@@ -16,7 +16,35 @@
   -->
 
 <resources>
-    <style name="Theme.Settings" parent="@android:style/Theme.DeviceDefault.Settings"/>
+    <!-- RavenOS: the search page uses the same glass look as Settings, whatever the system
+         dark theme switch says. Colors come from res/values/raven_glass.xml. -->
+    <style name="Theme.Settings" parent="@android:style/Theme.DeviceDefault">
+        <item name="android:windowBackground">@drawable/raven_backdrop</item>
+        <item name="android:colorBackground">@color/raven_bg</item>
+        <item name="android:colorBackgroundCacheHint">@null</item>
+        <item name="android:colorPrimary">@color/raven_bg</item>
+        <item name="android:colorPrimaryDark">@color/raven_bg</item>
+        <item name="android:colorAccent">@color/raven_accent</item>
+        <item name="android:colorControlNormal">@color/raven_fg</item>
+        <item name="android:colorControlHighlight">@color/raven_ripple</item>
+        <item name="android:textColorPrimary">@color/raven_text_primary</item>
+        <item name="android:textColorSecondary">@color/raven_text_secondary</item>
+        <item name="android:textColorTertiary">@color/raven_fg_3</item>
+        <item name="android:textColorHint">@color/raven_fg_3</item>
+        <item name="android:statusBarColor">@android:color/transparent</item>
+        <item name="android:navigationBarColor">@android:color/transparent</item>
+        <item name="android:enforceNavigationBarContrast">false</item>
+        <item name="android:windowLightStatusBar">@bool/raven_light_ui</item>
+        <item name="android:windowLightNavigationBar">@bool/raven_light_ui</item>
+        <item name="android:actionBarTheme">@style/ThemeOverlay.Raven.ActionBar</item>
+    </style>
+
+    <style name="ThemeOverlay.Raven.ActionBar" parent="@android:style/ThemeOverlay.Material.ActionBar">
+        <item name="android:textColorPrimary">@color/raven_text_primary</item>
+        <item name="android:textColorSecondary">@color/raven_text_secondary</item>
+        <item name="android:textColorHint">@color/raven_fg_3</item>
+        <item name="android:colorControlNormal">@color/raven_fg</item>
+    </style>
 
     <style name="Theme.Settings.NoActionBar">
         <item name="android:windowActionBar">false</item>
diff --git a/src/com/android/settings/intelligence/search/SearchFragment.java b/src/com/android/settings/intelligence/search/SearchFragment.java
