From 9e82d5277b37925095ef1aa14d7f842de0c68a16 Mon Sep 17 00:00:00 2001
From: baverrr <342259467+baverrr@users.noreply.github.com>
Date: Tue, 3 Nov 2026 15:48:37 -0700
Subject: [PATCH] AudioService: No tap sounds while media is playing

Touch, key and remote-button sounds are skipped while anything is
playing on the music stream, such as Bluetooth audio from a phone, so
they don't click over it. They come back as soon as playback stops.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I83204976e6b0251af8873486873f58f025eb6413
---
 .../core/java/com/android/server/audio/AudioService.java     | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/services/core/java/com/android/server/audio/AudioService.java b/services/core/java/com/android/server/audio/AudioService.java
index 5f67e9a7..5b74cc59 100644
--- a/services/core/java/com/android/server/audio/AudioService.java
+++ b/services/core/java/com/android/server/audio/AudioService.java
@@ -4092,6 +4092,11 @@ public class AudioService extends IAudioService.Stub
         if (isStreamMute(STREAM_SYSTEM)) {
             return;
         }
+        // RavenOS: stay quiet while music or other media is playing, so touches and remote
+        // presses don't click over it.
+        if (AudioSystem.isStreamActive(AudioSystem.STREAM_MUSIC, 0)) {
+            return;
+        }
 
         if (effectType >= AudioManager.NUM_SOUND_EFFECTS || effectType < 0) {
             Log.w(TAG, "AudioService effectType value " + effectType + " out of range");
-- 
2.53.0

