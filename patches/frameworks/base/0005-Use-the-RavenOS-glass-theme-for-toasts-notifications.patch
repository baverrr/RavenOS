+    <color name="raven_bg">#FF070B1D</color>
+    <color name="raven_glow_1">#CC0D9488</color>
+    <color name="raven_glow_2">#AA7C3AED</color>
+    <color name="raven_glow_3">#881E3A8A</color>
+    <color name="raven_fg">#FFF0F9FF</color>
+    <color name="raven_fg_2">#FFBAE6FD</color>
+    <color name="raven_fg_3">#FF7FA3C4</color>
+    <color name="raven_glass">#12FFFFFF</color>
+    <color name="raven_glass_stroke">#29BAE6FD</color>
+    <color name="raven_separator">#1ABAE6FD</color>
+    <color name="raven_ripple">#1FFFFFFF</color>
+    <color name="raven_accent">#FF22D3EE</color>
+    <color name="raven_on_accent">#FF04212A</color>
+    <color name="raven_switchbar_on">#2922D3EE</color>
+    <color name="raven_switchbar_on_stroke">#7322D3EE</color>
+    <color name="raven_tab_selected">#29FFFFFF</color>
+    <color name="raven_surface">#FF141B33</color>
+    <bool name="raven_light_ui">false</bool>
+    <dimen name="raven_card_radius">20dp</dimen>
+</resources>
