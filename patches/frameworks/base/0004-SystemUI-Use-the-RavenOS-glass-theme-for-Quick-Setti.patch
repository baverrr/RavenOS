new file mode 100644
index 00000000..18b90c3b
--- /dev/null
+++ b/packages/SystemUI/res/drawable/raven_dialog_bg.xml
@@ -0,0 +1,12 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: 2026 RavenOS
+     SPDX-License-Identifier: Apache-2.0
+-->
+<!-- Solid glass-theme card for SystemUI dialogs (Android 11 can't blur behind them). -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android"
+       android:shape="rectangle">
+    <solid android:color="@color/raven_surface" />
+    <stroke android:width="1dp" android:color="@color/raven_glass_stroke" />
+    <corners android:radius="@dimen/raven_card_radius" />
+</shape>
diff --git a/packages/SystemUI/res/drawable/raven_qs_backdrop.xml b/packages/SystemUI/res/drawable/raven_qs_backdrop.xml
new file mode 100644
index 00000000..dd9d0f83
--- /dev/null
+++ b/packages/SystemUI/res/drawable/raven_qs_backdrop.xml
@@ -0,0 +1,45 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: 2026 RavenOS
+     SPDX-License-Identifier: Apache-2.0
+-->
+<!-- Glass sheet behind Quick Settings: the Aurora navy with the same soft glows as the
+     Settings backdrop, clipped to the panel's rounded corners, with a hairline edge. -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <item>
+        <shape>
+            <solid android:color="@color/raven_bg" />
+            <corners android:radius="@dimen/raven_card_radius" />
+        </shape>
+    </item>
+    <item>
+        <shape android:dither="true">
+            <gradient android:type="radial" android:centerX="0.15" android:centerY="0.9"
+                android:gradientRadius="80%p"
+                android:startColor="@color/raven_glow_1" android:endColor="#00000000" />
+            <corners android:radius="@dimen/raven_card_radius" />
+        </shape>
+    </item>
+    <item>
+        <shape android:dither="true">
+            <gradient android:type="radial" android:centerX="0.8" android:centerY="0.15"
+                android:gradientRadius="75%p"
+                android:startColor="@color/raven_glow_2" android:endColor="#00000000" />
+            <corners android:radius="@dimen/raven_card_radius" />
+        </shape>
+    </item>
+    <item>
+        <shape android:dither="true">
+            <gradient android:type="radial" android:centerX="0.55" android:centerY="0.55"
+                android:gradientRadius="55%p"
+                android:startColor="@color/raven_glow_3" android:endColor="#00000000" />
+            <corners android:radius="@dimen/raven_card_radius" />
+        </shape>
+    </item>
+    <item>
+        <shape>
+            <stroke android:width="1dp" android:color="@color/raven_glass_stroke" />
+            <corners android:radius="@dimen/raven_card_radius" />
+        </shape>
+    </item>
+</layer-list>
