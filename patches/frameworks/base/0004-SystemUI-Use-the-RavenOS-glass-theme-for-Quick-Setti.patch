         <item name="android:windowIsFloating">true</item>
         <item name="android:homeAsUpIndicator">@drawable/ic_arrow_back</item>
+        <!-- RavenOS glass theme. Active tiles: accent circle with a dark icon (colorAccent,
+             colorPrimary). Inactive tiles: a faint glass circle (textColorTertiary at the
+             disabled alpha) with a light icon (textColorSecondary). -->
+        <item name="android:colorAccent">@color/raven_accent</item>
+        <item name="android:colorPrimary">@color/raven_on_accent</item>
+        <item name="android:textColorPrimary">@color/raven_fg</item>
+        <item name="android:textColorSecondary">@color/raven_fg_2</item>
+        <item name="android:textColorTertiary">@color/raven_fg_3</item>
+        <item name="android:colorForeground">@color/raven_fg</item>
+        <item name="android:colorControlNormal">@color/raven_fg_2</item>
+        <item name="android:colorControlActivated">@color/raven_accent</item>
+        <item name="android:colorControlHighlight">@color/raven_ripple</item>
+        <item name="android:colorBackgroundFloating">@color/raven_surface</item>
     </style>
 
     <style name="systemui_theme_remote_input" parent="@android:style/Theme.DeviceDefault.Light">
@@ -666,6 +679,17 @@
         <item name="android:windowIsFloating">true</item>
         <item name="android:backgroundDimEnabled">true</item>
         <item name="android:windowCloseOnTouchOutside">true</item>
+        <!-- RavenOS glass theme: a solid surface card with light text and accent controls. -->
+        <item name="android:colorBackgroundFloating">@color/raven_surface</item>
+        <item name="android:textColorPrimary">@color/raven_fg</item>
+        <item name="android:textColorSecondary">@color/raven_fg_2</item>
+        <item name="android:textColorTertiary">@color/raven_fg_3</item>
+        <item name="android:textColorPrimaryInverse">@color/raven_on_accent</item>
+        <item name="android:colorAccent">@color/raven_accent</item>
+        <item name="android:colorControlNormal">@color/raven_fg_2</item>
+        <item name="android:colorControlActivated">@color/raven_accent</item>
+        <item name="android:colorControlHighlight">@color/raven_ripple</item>
+        <item name="*android:isLightTheme">false</item>
