From dfb3652b8899b374478688cbcb41ce0dcfd4d9ae Mon Sep 17 00:00:00 2001
From: baverrr <342259467+baverrr@users.noreply.github.com>
Date: Mon, 2 Nov 2026 19:41:24 -0700
Subject: [PATCH] wifi: Add overlay to bring Wi-Fi up IPv4 only

Add config_wifiIpv4Only (default false). When an overlay sets it, Wi-Fi
provisions IpClient without IPv6, so no SLAAC address is taken and the
DNS servers a router advertises over IPv6 (RDNSS) are not used. This
lets a device rely only on the DNS servers set for the network, such as
a local filtering resolver.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I59cf5714b71838e10e5fe427596017ed940daf34
---
 service/java/com/android/server/wifi/ClientModeImpl.java | 6 ++++++
 service/res/values/config.xml                            | 4 ++++
 service/res/values/overlayable.xml                       | 1 +
 3 files changed, 11 insertions(+)

diff --git a/service/java/com/android/server/wifi/ClientModeImpl.java b/service/java/com/android/server/wifi/ClientModeImpl.java
index 14866c8..826afdb 100644
--- a/service/java/com/android/server/wifi/ClientModeImpl.java
+++ b/service/java/com/android/server/wifi/ClientModeImpl.java
@@ -6527,6 +6527,9 @@ public class ClientModeImpl extends StateMachine {
                 // Use EUI64 address generation for link-local IPv6 addresses.
                 prov.withRandomMacAddress();
             }
+            if (mContext.getResources().getBoolean(R.bool.config_wifiIpv4Only)) {
+                prov.withoutIPv6();
+            }
             mIpClient.startProvisioning(prov.build());
         } else {
             sendNetworkChangeBroadcast(DetailedState.OBTAINING_IPADDR);
@@ -6604,6 +6607,9 @@ public class ClientModeImpl extends StateMachine {
                 // Use EUI64 address generation for link-local IPv6 addresses.
                 prov.withRandomMacAddress();
             }
+            if (mContext.getResources().getBoolean(R.bool.config_wifiIpv4Only)) {
+                prov.withoutIPv6();
+            }
             mIpClient.startProvisioning(prov.build());
         }
 
diff --git a/service/res/values/config.xml b/service/res/values/config.xml
index def5f1e..d3c8e91 100644
--- a/service/res/values/config.xml
+++ b/service/res/values/config.xml
@@ -50,6 +50,10 @@
          Some Wi-Fi chipsets / driver combinations do not support this feature. -->
     <bool translatable="false" name="config_wifiSha256KeyManagementEnabled">true</bool>
 
+    <!-- Boolean indicating whether Wi-Fi should come up IPv4 only. When true, IPv6 is
+         not set up on Wi-Fi, so router advertised (RDNSS) DNS servers are not used. -->
+    <bool translatable="false" name="config_wifiIpv4Only">false</bool>
+
     <!-- Device type information conforming to Annex B format in WiFi Direct specification.
          The default represents a dual-mode smartphone -->
     <string translatable="false" name="config_wifi_p2p_device_type">10-0050F204-5</string>
diff --git a/service/res/values/overlayable.xml b/service/res/values/overlayable.xml
index 52fd44d..7933806 100644
--- a/service/res/values/overlayable.xml
+++ b/service/res/values/overlayable.xml
@@ -27,6 +27,7 @@
           <item type="integer" name="config_wifiFrameworkMaxNumSpatialStreamDeviceOverrideValue" />
           <item type="bool" name="config_wifi_fast_bss_transition_enabled" />
           <item type="bool" name="config_wifiSha256KeyManagementEnabled" />
+          <item type="bool" name="config_wifiIpv4Only" />
           <item type="string" name="config_wifi_p2p_device_type" />
           <item type="bool" name="config_wifi_background_scan_support" />
           <item type="bool" name="config_wifi_revert_country_code_on_cellular_loss" />
-- 
