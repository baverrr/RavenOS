diff --git a/EchoParts/res/values/styles.xml b/EchoParts/res/values/styles.xml
new file mode 100644
index 0000000..8201d8f
--- /dev/null
+++ b/EchoParts/res/values/styles.xml
@@ -0,0 +1,39 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: 2026 The LineageOS Project
+     SPDX-License-Identifier: Apache-2.0
+-->
+<resources>
+    <!-- Same glass look as Android Settings. Colors come from settings_glass.xml, which a
+         product overlay can replace to match the device's Settings theme. -->
+    <style name="EchoPartsSettings" parent="@android:style/Theme.DeviceDefault.Settings">
+        <item name="android:windowBackground">@drawable/settings_backdrop</item>
+        <item name="android:colorBackground">@color/settings_bg</item>
+        <item name="android:statusBarColor">@android:color/transparent</item>
+        <item name="android:navigationBarColor">@android:color/transparent</item>
+        <item name="android:actionBarStyle">@style/EchoPartsSettings.ActionBar</item>
+        <item name="android:colorAccent">@color/settings_accent</item>
+        <item name="android:colorControlActivated">@color/settings_accent</item>
+        <item name="android:textColorPrimary">@color/settings_fg</item>
+        <item name="android:textColorSecondary">@color/settings_fg_2</item>
+        <item name="android:preferenceCategoryStyle">@style/EchoPartsSettings.Category</item>
+        <item name="android:alertDialogTheme">@style/EchoPartsSettingsDialog</item>
+    </style>
+
+    <style name="EchoPartsSettings.ActionBar" parent="@android:style/Widget.DeviceDefault.ActionBar.Solid">
+        <item name="android:background">@android:color/transparent</item>
+        <item name="android:elevation">0dp</item>
+    </style>
+
+    <style name="EchoPartsSettings.Category" parent="@*android:style/Preference.Material.Category">
+        <item name="android:layout">@layout/settings_category</item>
+    </style>
+
+    <!-- Dialogs stay on a solid surface: Android 11 can't blur behind them. -->
+    <style name="EchoPartsSettingsDialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
+        <item name="android:colorAccent">@color/settings_accent</item>
+        <item name="android:colorBackground">@color/settings_surface</item>
+        <item name="android:textColorPrimary">@color/settings_fg</item>
+        <item name="android:textColorSecondary">@color/settings_fg_2</item>
+    </style>
+</resources>
