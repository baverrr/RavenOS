<!-- Lets Dicio open the assistant on "Hey Raven", and open reminders and the wake-up alarm,
     from the background. Lineage enforces this list, so it must match Dicio's manifest. -->
<permissions>
    <privapp-permissions package="org.stypox.dicio">
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    </privapp-permissions>
</permissions>
