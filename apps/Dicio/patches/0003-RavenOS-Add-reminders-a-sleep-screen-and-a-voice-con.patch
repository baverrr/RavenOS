--- /dev/null
+++ b/app/src/main/kotlin/org/stypox/dicio/alerts/AlertReceiver.kt
@@ -0,0 +1,68 @@
+package org.stypox.dicio.alerts
+
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.util.Log
+import androidx.core.app.NotificationCompat
+import org.stypox.dicio.R
+import org.stypox.dicio.io.wake.canStartFromBackground
+
+/**
+ * Rings an alert when its alarm fires, and schedules every stored alert again after a reboot
+ * or an app update (alerts whose time passed meanwhile ring right away).
+ */
+class AlertReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        when (intent.action) {
+            ACTION_FIRE -> {
+                val alert = Alerts.take(context, intent.getLongExtra(EXTRA_ID, -1)) ?: return
+                ring(context, alert)
+            }
+            Intent.ACTION_BOOT_COMPLETED,
+            Intent.ACTION_MY_PACKAGE_REPLACED -> Alerts.rescheduleAll(context)
+        }
+    }
+
+    private fun ring(context: Context, alert: Alert) {
+        Log.d(TAG, "Ringing alert ${alert.id} (${alert.kind})")
+        val activityIntent = AlertActivity.intent(context, alert)
+        if (canStartFromBackground(context)) {
+            context.startActivity(activityIntent)
+            return
+        }
+
+        // Without the RavenOS system app permission, Android 10+ only lets us start the
+        // activity through a full-screen notification.
+        val manager = context.getSystemService(NotificationManager::class.java)
+        manager.createNotificationChannel(NotificationChannel(
+            CHANNEL_ID,
+            context.getString(R.string.alert_channel_name),
+            NotificationManager.IMPORTANCE_HIGH,
+        ))
+        val pendingIntent = PendingIntent.getActivity(
+            context, alert.id.toInt(), activityIntent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+        manager.notify(alert.id.toInt(), NotificationCompat.Builder(context, CHANNEL_ID)
+            .setSmallIcon(R.drawable.ic_hearing_white)
+            .setContentTitle(AlertActivity.title(context, alert))
+            .setContentText(alert.text)
+            .setCategory(NotificationCompat.CATEGORY_ALARM)
+            .setPriority(NotificationCompat.PRIORITY_MAX)
+            .setFullScreenIntent(pendingIntent, true)
+            .setContentIntent(pendingIntent)
+            .setAutoCancel(true)
+            .build())
+    }
+
+    companion object {
+        val TAG = AlertReceiver::class.simpleName
+        const val ACTION_FIRE = "org.stypox.dicio.alerts.FIRE"
+        const val EXTRA_ID = "id"
+        private const val CHANNEL_ID = "alerts"
+    }
+}
diff --git a/app/src/main/kotlin/org/stypox/dicio/alerts/AlertTime.kt b/app/src/main/kotlin/org/stypox/dicio/alerts/AlertTime.kt
new file mode 100644
index 0000000..1e194b9
--- /dev/null
+++ b/app/src/main/kotlin/org/stypox/dicio/alerts/AlertTime.kt
@@ -0,0 +1,75 @@
+package org.stypox.dicio.alerts
+
+import org.dicio.numbers.ParserFormatter
+import java.time.Duration
+import java.time.LocalDate
+import java.time.LocalDateTime
+import java.time.ZoneId
+
+object AlertTime {
+    private val CONNECTORS = setOf(
+        "at", "on", "in", "by", "for", "to", "about", "that", "until", "till", "me", "and", "of"
+    )
+    private val MORNING = Regex("\\b(a ?m|morning)\\b", RegexOption.IGNORE_CASE)
+
+    /**
+     * Splits a spoken phrase such as "call mom tomorrow at six pm" into the time it names (moved
+     * to its next occurrence, see [nextOccurrence]) and the remaining words ("call mom").
+     */
+    fun extract(
+        parserFormatter: ParserFormatter,
+        text: String,
+        now: LocalDateTime = LocalDateTime.now(),
+    ): Pair<LocalDateTime?, String> {
+        var time: LocalDateTime? = null
+        val rest = StringBuilder()
+        for (item in parserFormatter.extractDateTime(text).now(now).parseMixedWithText()) {
+            if (item is LocalDateTime && time == null) {
+                time = item
+            } else {
+                rest.append(item.toString())
+            }
+        }
+        return Pair(
+            time?.let { nextOccurrence(it, now, explicitMorning = MORNING.containsMatchIn(text)) },
+            trimConnectors(rest.toString()),
+        )
+    }
+
+    /**
+     * A time without a date that already passed today most likely means the next one: "at six"
+     * said at 8 pm means 6 am tomorrow, and said at 10 am it means 6 pm today.
+     */
+    fun nextOccurrence(
+        time: LocalDateTime,
+        now: LocalDateTime,
+        explicitMorning: Boolean,
+    ): LocalDateTime {
+        if (time.isAfter(now) || Duration.between(time, now) > Duration.ofDays(1)) {
+            return time
+        }
+        val evening = time.plusHours(12)
+        if (!explicitMorning && time.hour < 12 && evening.isAfter(now) &&
+            evening.toLocalDate() == time.toLocalDate()) {
+            return evening
+        }
+        return time.plusDays(1)
+    }
+
+    /** "tomorrow at 7:00 AM", for both speech and the screen. */
+    fun describe(parserFormatter: ParserFormatter, time: LocalDateTime): String =
+        parserFormatter.niceDateTime(time).now(LocalDate.now()).get()
+
+    fun toEpochMillis(time: LocalDateTime): Long =
+        time.atZone(ZoneId.systemDefault()).toInstant().toEpochMilli()
+
+    fun fromEpochMillis(millis: Long): LocalDateTime =
+        LocalDateTime.ofInstant(java.time.Instant.ofEpochMilli(millis), ZoneId.systemDefault())
+
+    private fun trimConnectors(text: String): String {
+        val words = text.trim().split(Regex("\\s+")).filter { it.isNotEmpty() }.toMutableList()
+        while (words.isNotEmpty() && words.first().lowercase() in CONNECTORS) words.removeAt(0)
+        while (words.isNotEmpty() && words.last().lowercase() in CONNECTORS) words.removeAt(words.size - 1)
+        return words.joinToString(" ")
+    }
+}
