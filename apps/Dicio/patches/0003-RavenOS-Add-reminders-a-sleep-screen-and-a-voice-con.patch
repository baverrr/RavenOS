@@ -0,0 +1,153 @@
+package org.stypox.dicio.alerts
+
+import android.app.AlarmManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import org.json.JSONArray
+import org.json.JSONObject
+import org.stypox.dicio.MainActivity
+
+enum class AlertKind { REMINDER, WAKE }
+
+/** A reminder, or the wake-up alarm set when going to sleep. [time] is epoch milliseconds. */
+data class Alert(val id: Long, val time: Long, val kind: AlertKind, val text: String)
+
+/**
+ * RavenOS: stores, schedules and rings reminders and wake-up alarms. Alerts survive reboots
+ * (see [AlertReceiver]) and ring in [AlertActivity] until turned off, by voice or by touch.
+ */
+object Alerts {
+    private const val PREFS = "ravenos_alerts"
+    private const val KEY_ALERTS = "alerts"
+    private const val KEY_NEXT_ID = "next_id"
+
+    private val _ringing = MutableStateFlow<Alert?>(null)
+    /** The alert that is going off right now, if any. */
+    val ringing: StateFlow<Alert?> = _ringing
+
+    private val _sleeping = MutableStateFlow(false)
+    /** Whether the dimmed sleep screen is showing. */
+    val sleeping: StateFlow<Boolean> = _sleeping
+
+    private val _quietUntil = MutableStateFlow(0L)
+    /** Ringing stays quiet until this time, so the microphone can hear a command. */
+    val quietUntil: StateFlow<Long> = _quietUntil
+
+    fun all(context: Context): List<Alert> = load(context).sortedBy { it.time }
+
+    fun add(context: Context, time: Long, kind: AlertKind, text: String): Alert {
+        val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        val id = prefs.getLong(KEY_NEXT_ID, 1)
+        prefs.edit().putLong(KEY_NEXT_ID, id + 1).apply()
+        val alert = Alert(id, time, kind, text)
+        save(context, load(context) + alert)
+        schedule(context, alert)
+        return alert
+    }
+
+    fun remove(context: Context, alert: Alert) {
+        save(context, load(context).filter { it.id != alert.id })
+        alarmManager(context).cancel(firePendingIntent(context, alert.id))
+    }
+
+    /** Called when an alarm fires: forgets the alert and returns it, if it still exists. */
+    fun take(context: Context, id: Long): Alert? {
+        val alerts = load(context)
+        val alert = alerts.firstOrNull { it.id == id } ?: return null
+        save(context, alerts.filter { it.id != id })
+        return alert
+    }
+
+    /** Schedules every stored alert again; alarms are lost on reboot. */
+    fun rescheduleAll(context: Context) {
+        for (alert in load(context)) {
+            schedule(context, alert)
+        }
+    }
+
+    fun startRinging(alert: Alert) {
+        _ringing.value = alert
+        _sleeping.value = false
+    }
+
+    /** Stops whatever is going off. Returns false if nothing was. */
+    fun turnOff(): Boolean {
+        val wasRinging = _ringing.value != null
+        _ringing.value = null
+        return wasRinging
+    }
+
+    /** Stops whatever is going off and rings it again in [minutes]. Returns it, or null. */
+    fun snooze(context: Context, minutes: Long): Alert? {
+        val alert = _ringing.value ?: return null
+        _ringing.value = null
+        return add(context, System.currentTimeMillis() + minutes * 60_000, alert.kind, alert.text)
+    }
+
+    fun setSleeping(sleeping: Boolean) {
+        _sleeping.value = sleeping
+    }
+
+    /** The wake word was heard: hold the alarm sound for a while so the command is heard. */
+    fun onWakeWord() {
+        _quietUntil.value = System.currentTimeMillis() + QUIET_AFTER_WAKE_WORD_MILLIS
+    }
+
+    private fun schedule(context: Context, alert: Alert) {
+        // setAlarmClock is exact, fires in doze, and needs no extra permission on Android 11.
+        val showIntent = PendingIntent.getActivity(
+            context, 0, Intent(context, MainActivity::class.java),
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+        alarmManager(context).setAlarmClock(
+            AlarmManager.AlarmClockInfo(alert.time, showIntent),
+            firePendingIntent(context, alert.id),
+        )
+    }
+
+    private fun firePendingIntent(context: Context, id: Long): PendingIntent =
+        PendingIntent.getBroadcast(
+            context, id.toInt(),
+            Intent(context, AlertReceiver::class.java)
+                .setAction(AlertReceiver.ACTION_FIRE)
+                .putExtra(AlertReceiver.EXTRA_ID, id),
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+
+    private fun alarmManager(context: Context) =
+        context.getSystemService(AlarmManager::class.java)
+
+    private fun load(context: Context): List<Alert> {
+        val json = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .getString(KEY_ALERTS, null) ?: return listOf()
+        val array = JSONArray(json)
+        return (0 until array.length()).map { i ->
+            val o = array.getJSONObject(i)
+            Alert(
+                id = o.getLong("id"),
+                time = o.getLong("time"),
+                kind = AlertKind.valueOf(o.getString("kind")),
+                text = o.getString("text"),
+            )
+        }
+    }
+
+    private fun save(context: Context, alerts: List<Alert>) {
+        val array = JSONArray()
+        for (alert in alerts) {
+            array.put(JSONObject()
+                .put("id", alert.id)
+                .put("time", alert.time)
+                .put("kind", alert.kind.name)
+                .put("text", alert.text))
+        }
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+            .putString(KEY_ALERTS, array.toString())
+            .apply()
+    }
+
+    private const val QUIET_AFTER_WAKE_WORD_MILLIS = 12_000L
+}
