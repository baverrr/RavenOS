@@ -0,0 +1,248 @@
+package org.stypox.dicio.alerts
+
+import android.content.Context
+import android.content.Intent
+import android.media.AudioAttributes
+import android.media.Ringtone
+import android.media.RingtoneManager
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.speech.tts.TextToSpeech
+import android.view.WindowManager
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.setContent
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.Button
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.OutlinedButton
+import androidx.compose.material3.Surface
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.text.style.TextAlign
+import androidx.compose.ui.unit.dp
+import androidx.lifecycle.lifecycleScope
+import kotlinx.coroutines.launch
+import org.stypox.dicio.R
+import org.stypox.dicio.settings.datastore.Theme
+import org.stypox.dicio.ui.theme.AppTheme
+import java.time.LocalTime
+import java.time.format.DateTimeFormatter
+import java.time.format.FormatStyle
+
+/**
+ * Full-screen alert for a reminder or the wake-up alarm. It rings until turned off by touch or
+ * by voice ("Hey Raven, turn off"), and goes quiet briefly whenever the wake word is heard.
+ */
+class AlertActivity : ComponentActivity() {
+    private val handler = Handler(Looper.getMainLooper())
+    private val alertState = mutableStateOf<Alert?>(null)
+    private var ringtone: Ringtone? = null
+    private var tts: TextToSpeech? = null
+    private var ttsReady = false
+    private var startedAt = 0L
+    private var spokenTimes = 0
+
+    private val tick = object : Runnable {
+        override fun run() {
+            onTick()
+            handler.postDelayed(this, TICK_MILLIS)
+        }
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setShowWhenLocked(true)
+        setTurnScreenOn(true)
+        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+        window.attributes = window.attributes.apply {
+            screenBrightness = WindowManager.LayoutParams.BRIGHTNESS_OVERRIDE_FULL
+        }
+
+        tts = TextToSpeech(this) { status -> ttsReady = status == TextToSpeech.SUCCESS }
+        startAlert(intent)
+
+        setContent {
+            AppTheme(theme = Theme.THEME_DARK) {
+                alertState.value?.let { AlertScreen(it) }
+            }
+        }
+
+        lifecycleScope.launch {
+            Alerts.ringing.collect { ringing ->
+                if (ringing == null) {
+                    finish()
+                }
+            }
+        }
+        handler.post(tick)
+    }
+
+    override fun onNewIntent(intent: Intent) {
+        super.onNewIntent(intent)
+        startAlert(intent)
+    }
+
+    override fun onDestroy() {
+        handler.removeCallbacks(tick)
+        stopSound()
+        tts?.shutdown()
+        if (Alerts.ringing.value?.id == alertState.value?.id) {
+            Alerts.turnOff()
+        }
+        super.onDestroy()
+    }
+
+    private fun startAlert(intent: Intent) {
+        val alert = Alert(
+            id = intent.getLongExtra(EXTRA_ID, -1),
+            time = intent.getLongExtra(EXTRA_TIME, System.currentTimeMillis()),
+            kind = AlertKind.valueOf(intent.getStringExtra(EXTRA_KIND) ?: AlertKind.WAKE.name),
+            text = intent.getStringExtra(EXTRA_TEXT) ?: "",
+        )
+        stopSound()
+        alertState.value = alert
+        startedAt = System.currentTimeMillis()
+        spokenTimes = 0
+        ringtone = RingtoneManager.getActualDefaultRingtoneUri(
+            this,
+            if (alert.kind == AlertKind.WAKE) RingtoneManager.TYPE_ALARM
+            else RingtoneManager.TYPE_NOTIFICATION,
+        )?.let { RingtoneManager.getRingtone(this, it) }?.apply {
+            audioAttributes = AudioAttributes.Builder()
+                .setUsage(AudioAttributes.USAGE_ALARM)
+                .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
+                .build()
+        }
+        Alerts.startRinging(alert)
+    }
+
+    private fun onTick() {
+        val alert = alertState.value ?: return
+        val now = System.currentTimeMillis()
+        if (now - startedAt > MAX_RING_MILLIS) {
+            Alerts.turnOff()
+            return
+        }
+        val quiet = now < Alerts.quietUntil.value
+        val second = (now - startedAt) / 1000
+
+        when (alert.kind) {
+            AlertKind.WAKE -> {
+                // Ring in bursts, so the microphone can hear "Hey Raven" in the gaps.
+                val inBurst = second % WAKE_CYCLE_SECONDS < WAKE_BURST_SECONDS
+                if (inBurst && !quiet) playSound() else stopSound()
+                if (second == WAKE_BURST_SECONDS.toLong() && !quiet) {
+                    speak(getString(R.string.alert_good_morning, formatTime(LocalTime.now())))
+                }
+            }
+            AlertKind.REMINDER -> {
+                // A chime, then the reminder read aloud, repeated a few times.
+                if (second % REMINDER_REPEAT_SECONDS == 0L && spokenTimes < REMINDER_REPEATS &&
+                    !quiet) {
+                    spokenTimes += 1
+                    stopSound()
+                    playSound()
+                    handler.postDelayed({
+                        speak(getString(R.string.alert_reminder_speech, alert.text))
+                    }, REMINDER_SPEECH_DELAY_MILLIS)
+                }
+            }
+        }
+    }
+
+    private fun playSound() {
+        if (ringtone?.isPlaying == false) {
+            ringtone?.play()
+        }
+    }
+
+    private fun stopSound() {
+        ringtone?.stop()
+    }
+
+    private fun speak(text: String) {
+        if (ttsReady) {
+            tts?.speak(text, TextToSpeech.QUEUE_FLUSH, null, "alert")
+        }
+    }
+
+    @Composable
+    private fun AlertScreen(alert: Alert) {
+        Surface(modifier = Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
+            Column(
+                modifier = Modifier.fillMaxSize().padding(32.dp),
+                verticalArrangement = Arrangement.spacedBy(24.dp, Alignment.CenterVertically),
+                horizontalAlignment = Alignment.CenterHorizontally,
+            ) {
+                Text(
+                    text = formatTime(LocalTime.now()),
+                    style = MaterialTheme.typography.displayLarge,
+                )
+                Text(
+                    text = title(this@AlertActivity, alert),
+                    style = MaterialTheme.typography.headlineMedium,
+                )
+                if (alert.text.isNotBlank()) {
+                    Text(
+                        text = alert.text,
+                        style = MaterialTheme.typography.headlineSmall,
+                        textAlign = TextAlign.Center,
+                    )
+                }
+                Row(horizontalArrangement = Arrangement.spacedBy(16.dp)) {
+                    OutlinedButton(onClick = { Alerts.snooze(this@AlertActivity, SNOOZE_MINUTES) }) {
+                        Text(stringResource(R.string.alert_snooze, SNOOZE_MINUTES))
+                    }
+                    Button(onClick = { Alerts.turnOff() }) {
+                        Text(stringResource(R.string.alert_turn_off))
+                    }
+                }
+                Text(
+                    text = stringResource(R.string.alert_voice_hint),
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+            }
+        }
+    }
+
+    companion object {
+        const val SNOOZE_MINUTES = 10L
+        private const val EXTRA_ID = "id"
+        private const val EXTRA_TIME = "time"
+        private const val EXTRA_KIND = "kind"
+        private const val EXTRA_TEXT = "text"
+        private const val TICK_MILLIS = 1000L
+        private const val MAX_RING_MILLIS = 15 * 60_000L
+        private const val WAKE_CYCLE_SECONDS = 9
+        private const val WAKE_BURST_SECONDS = 6
+        private const val REMINDER_REPEAT_SECONDS = 30
+        private const val REMINDER_REPEATS = 5
+        private const val REMINDER_SPEECH_DELAY_MILLIS = 1500L
+
+        fun intent(context: Context, alert: Alert): Intent =
+            Intent(context, AlertActivity::class.java)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP)
+                .putExtra(EXTRA_ID, alert.id)
+                .putExtra(EXTRA_TIME, alert.time)
+                .putExtra(EXTRA_KIND, alert.kind.name)
+                .putExtra(EXTRA_TEXT, alert.text)
+
+        fun title(context: Context, alert: Alert): String = context.getString(
+            if (alert.kind == AlertKind.WAKE) R.string.alert_title_wake
+            else R.string.alert_title_reminder
+        )
+
+        fun formatTime(time: LocalTime): String =
+            time.format(DateTimeFormatter.ofLocalizedTime(FormatStyle.SHORT))
+    }
+}
