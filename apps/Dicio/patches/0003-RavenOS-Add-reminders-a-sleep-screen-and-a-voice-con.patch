@@ -0,0 +1,97 @@
+package org.stypox.dicio.skills.reminder
+
+import org.dicio.skill.context.SkillContext
+import org.dicio.skill.skill.SkillInfo
+import org.dicio.skill.skill.SkillOutput
+import org.dicio.skill.standard.StandardRecognizerData
+import org.dicio.skill.standard.StandardRecognizerSkill
+import org.stypox.dicio.R
+import org.stypox.dicio.alerts.AlertKind
+import org.stypox.dicio.alerts.AlertSpeechOutput
+import org.stypox.dicio.alerts.AlertTime
+import org.stypox.dicio.alerts.Alerts
+import org.stypox.dicio.alerts.AskTimeOutput
+import org.stypox.dicio.sentences.Sentences.Reminder
+import org.stypox.dicio.util.getString
+import java.time.LocalDateTime
+
+/**
+ * RavenOS: "remind me to call mom tomorrow at six", "what are my reminders", "cancel my
+ * reminder to call mom". Reminders are spoken and shown on screen when due (see Alerts).
+ */
+class ReminderSkill(
+    correspondingSkillInfo: SkillInfo,
+    data: StandardRecognizerData<Reminder>,
+) : StandardRecognizerSkill<Reminder>(correspondingSkillInfo, data) {
+
+    override suspend fun generateOutput(ctx: SkillContext, inputData: Reminder): SkillOutput {
+        return when (inputData) {
+            is Reminder.Set -> set(ctx, inputData.what)
+            is Reminder.Query -> query(ctx)
+            is Reminder.Cancel -> cancel(ctx, inputData.what)
+        }
+    }
+
+    private fun set(ctx: SkillContext, what: String?): SkillOutput {
+        if (what.isNullOrBlank()) {
+            return AlertSpeechOutput(ctx.getString(R.string.skill_reminder_what))
+        }
+        val (time, text) = AlertTime.extract(ctx.parserFormatter!!, what)
+        val reminderText = text.ifBlank { what }
+        return if (time == null) {
+            AskTimeOutput(ctx.getString(R.string.skill_reminder_when), ReminderInfo) {
+                add(ctx, it, reminderText)
+            }
+        } else {
+            add(ctx, time, reminderText)
+        }
+    }
+
+    private fun add(ctx: SkillContext, time: LocalDateTime, text: String): SkillOutput {
+        Alerts.add(ctx.android, AlertTime.toEpochMillis(time), AlertKind.REMINDER, text)
+        return AlertSpeechOutput(ctx.getString(
+            R.string.skill_reminder_set, text, AlertTime.describe(ctx.parserFormatter!!, time)
+        ))
+    }
+
+    private fun query(ctx: SkillContext): SkillOutput {
+        val reminders = Alerts.all(ctx.android).filter { it.kind == AlertKind.REMINDER }
+        if (reminders.isEmpty()) {
+            return AlertSpeechOutput(ctx.getString(R.string.skill_reminder_none))
+        }
+        val list = reminders.take(MAX_LISTED).joinToString("; ") {
+            ctx.getString(
+                R.string.skill_reminder_item, it.text,
+                AlertTime.describe(ctx.parserFormatter!!, AlertTime.fromEpochMillis(it.time))
+            )
+        }
+        return AlertSpeechOutput(ctx.android.resources.getQuantityString(
+            R.plurals.skill_reminder_list, reminders.size, reminders.size, list
+        ))
+    }
+
+    private fun cancel(ctx: SkillContext, what: String?): SkillOutput {
+        val reminders = Alerts.all(ctx.android).filter { it.kind == AlertKind.REMINDER }
+        if (reminders.isEmpty()) {
+            return AlertSpeechOutput(ctx.getString(R.string.skill_reminder_none))
+        }
+        if (what.isNullOrBlank()) {
+            reminders.forEach { Alerts.remove(ctx.android, it) }
+            return AlertSpeechOutput(ctx.android.resources.getQuantityString(
+                R.plurals.skill_reminder_canceled_all, reminders.size, reminders.size
+            ))
+        }
+        // Pick the reminder sharing the most words with what was said.
+        val words = what.lowercase().split(" ").toSet()
+        val best = reminders.maxBy { r -> r.text.lowercase().split(" ").count { it in words } }
+        if (best.text.lowercase().split(" ").none { it in words }) {
+            return AlertSpeechOutput(ctx.getString(R.string.skill_reminder_not_found, what))
+        }
+        Alerts.remove(ctx.android, best)
+        return AlertSpeechOutput(ctx.getString(R.string.skill_reminder_canceled, best.text))
+    }
+
+    companion object {
+        private const val MAX_LISTED = 5
+    }
+}
