+package org.stypox.dicio.skills.sleep
+
+import android.content.Context
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.filled.Bedtime
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.graphics.vector.rememberVectorPainter
+import org.dicio.skill.context.SkillContext
+import org.dicio.skill.skill.Skill
+import org.dicio.skill.skill.SkillInfo
+import org.stypox.dicio.R
+import org.stypox.dicio.sentences.Sentences
+
+object SleepInfo : SkillInfo("sleep") {
+    override fun name(context: Context) =
+        context.getString(R.string.skill_name_sleep)
+
+    override fun sentenceExample(context: Context) =
+        context.getString(R.string.skill_sentence_example_sleep)
+
+    @Composable
+    override fun icon() =
+        rememberVectorPainter(Icons.Default.Bedtime)
+
+    override fun build(ctx: SkillContext): Skill<*>? {
+        val data = Sentences.Sleep[ctx.sentencesLanguage] ?: return null
+        if (ctx.parserFormatter == null) return null
+        return SleepSkill(SleepInfo, data)
+    }
+}
diff --git a/app/src/main/kotlin/org/stypox/dicio/skills/sleep/SleepSkill.kt b/app/src/main/kotlin/org/stypox/dicio/skills/sleep/SleepSkill.kt
new file mode 100644
index 0000000..440fc2e
--- /dev/null
+++ b/app/src/main/kotlin/org/stypox/dicio/skills/sleep/SleepSkill.kt
@@ -0,0 +1,82 @@
+package org.stypox.dicio.skills.sleep
+
+import android.os.Handler
+import android.os.Looper
+import org.dicio.skill.context.SkillContext
+import org.dicio.skill.skill.SkillInfo
+import org.dicio.skill.skill.SkillOutput
+import org.dicio.skill.standard.StandardRecognizerData
+import org.dicio.skill.standard.StandardRecognizerSkill
+import org.stypox.dicio.R
+import org.stypox.dicio.alerts.AlertKind
+import org.stypox.dicio.alerts.AlertSpeechOutput
+import org.stypox.dicio.alerts.AlertTime
+import org.stypox.dicio.alerts.Alerts
+import org.stypox.dicio.alerts.AskTimeOutput
+import org.stypox.dicio.alerts.SleepActivity
+import org.stypox.dicio.sentences.Sentences.Sleep
+import org.stypox.dicio.util.getString
+import java.time.LocalDateTime
+
+/**
+ * RavenOS: "go to sleep until six thirty" dims the screen to a faint clock and sets a wake-up
+ * alarm; "wake me up at seven" only sets the alarm; "wake up" leaves the sleep screen and
+ * cancels the alarm. "Turn off" (see alert_control) stops the alarm when it rings.
+ */
+class SleepSkill(
+    correspondingSkillInfo: SkillInfo,
+    data: StandardRecognizerData<Sleep>,
+) : StandardRecognizerSkill<Sleep>(correspondingSkillInfo, data) {
+
+    override suspend fun generateOutput(ctx: SkillContext, inputData: Sleep): SkillOutput {
+        return when (inputData) {
+            is Sleep.GoToSleep -> withTime(ctx, inputData.time) { setWakeAlarm(ctx, it, sleep = true) }
+            is Sleep.Alarm -> withTime(ctx, inputData.time) { setWakeAlarm(ctx, it, sleep = false) }
+            is Sleep.WakeUp -> wakeUp(ctx)
+        }
+    }
+
+    private fun withTime(
+        ctx: SkillContext,
+        spokenTime: String?,
+        onTime: (LocalDateTime) -> SkillOutput,
+    ): SkillOutput {
+        val time = spokenTime?.let { AlertTime.extract(ctx.parserFormatter!!, it).first }
+        return time?.let(onTime)
+            ?: AskTimeOutput(ctx.getString(R.string.skill_sleep_when), SleepInfo) { onTime(it) }
+    }
+
+    private fun setWakeAlarm(ctx: SkillContext, time: LocalDateTime, sleep: Boolean): SkillOutput {
+        // Only one wake-up alarm at a time.
+        Alerts.all(ctx.android).filter { it.kind == AlertKind.WAKE }
+            .forEach { Alerts.remove(ctx.android, it) }
+        val millis = AlertTime.toEpochMillis(time)
+        Alerts.add(ctx.android, millis, AlertKind.WAKE, "")
+        val described = AlertTime.describe(ctx.parserFormatter!!, time)
+
+        if (!sleep) {
+            return AlertSpeechOutput(ctx.getString(R.string.skill_sleep_alarm_set, described))
+        }
+        // Give the reply a moment to be heard before the screen goes dark.
+        Handler(Looper.getMainLooper()).postDelayed(
+            { SleepActivity.start(ctx.android, millis) }, SLEEP_SCREEN_DELAY_MILLIS
+        )
+        return AlertSpeechOutput(ctx.getString(R.string.skill_sleep_good_night, described))
+    }
+
+    private fun wakeUp(ctx: SkillContext): SkillOutput {
+        val wasSleeping = Alerts.sleeping.value
+        Alerts.setSleeping(false)
+        val alarms = Alerts.all(ctx.android).filter { it.kind == AlertKind.WAKE }
+        alarms.forEach { Alerts.remove(ctx.android, it) }
+        return AlertSpeechOutput(ctx.getString(
+            if (alarms.isNotEmpty()) R.string.skill_sleep_awake_alarm_off
+            else if (wasSleeping) R.string.skill_sleep_awake
+            else R.string.skill_sleep_not_sleeping
+        ))
+    }
+
+    companion object {
+        private const val SLEEP_SCREEN_DELAY_MILLIS = 3_000L
+    }
+}
