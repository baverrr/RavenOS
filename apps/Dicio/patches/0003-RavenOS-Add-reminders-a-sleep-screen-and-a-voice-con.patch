+package org.stypox.dicio.alerts
+
+import org.dicio.skill.context.SkillContext
+import org.dicio.skill.skill.AlwaysBestScore
+import org.dicio.skill.skill.AlwaysWorstScore
+import org.dicio.skill.skill.InteractionPlan
+import org.dicio.skill.skill.Score
+import org.dicio.skill.skill.Skill
+import org.dicio.skill.skill.SkillInfo
+import org.dicio.skill.skill.SkillOutput
+import org.dicio.skill.skill.Specificity
+import org.stypox.dicio.io.graphical.HeadlineSpeechSkillOutput
+import java.time.LocalDateTime
+
+/** A spoken answer that is also shown as a headline. */
+class AlertSpeechOutput(private val speech: String) : HeadlineSpeechSkillOutput {
+    override fun getSpeechOutput(ctx: SkillContext): String = speech
+}
+
+/**
+ * Asks a question and listens for a time in the answer, e.g. "What time should I wake you
+ * up?", then hands the time to [onGotTime].
+ */
+class AskTimeOutput(
+    private val question: String,
+    private val skillInfo: SkillInfo,
+    private val onGotTime: suspend (LocalDateTime) -> SkillOutput,
+) : HeadlineSpeechSkillOutput {
+    override fun getSpeechOutput(ctx: SkillContext): String = question
+
+    override fun getInteractionPlan(ctx: SkillContext): InteractionPlan {
+        val timeSkill = object : Skill<LocalDateTime?>(skillInfo, Specificity.HIGH) {
+            override fun score(ctx: SkillContext, input: String): Pair<Score, LocalDateTime?> {
+                val time = AlertTime.extract(ctx.parserFormatter!!, input).first
+                return Pair(if (time == null) AlwaysWorstScore else AlwaysBestScore, time)
+            }
+
+            override suspend fun generateOutput(
+                ctx: SkillContext,
+                inputData: LocalDateTime?,
+            ): SkillOutput = onGotTime(
+                // AlwaysWorstScore above means inputData is never null here
+                inputData ?: throw IllegalStateException("No time was recognized")
+            )
+        }
+        return InteractionPlan.StartSubInteraction(
+            reopenMicrophone = true,
+            nextSkills = listOf(timeSkill),
+        )
+    }
+}
diff --git a/app/src/main/kotlin/org/stypox/dicio/alerts/AlertReceiver.kt b/app/src/main/kotlin/org/stypox/dicio/alerts/AlertReceiver.kt
new file mode 100644
