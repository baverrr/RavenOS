+/*
+ * Based on org.vosk.android.SpeechService from vosk-android 0.3.70
+ * Copyright 2019 Alpha Cephei Inc., licensed under the Apache License, Version 2.0.
+ *
+ * RavenOS: the same service, but recording from MIC_SOURCE instead of the hardcoded
+ * VOICE_RECOGNITION source.
+ */
+
+package org.stypox.dicio.io.input.vosk
+
+import android.annotation.SuppressLint
+import android.media.AudioFormat
+import android.media.AudioRecord
+import android.os.Handler
+import android.os.Looper
+import org.stypox.dicio.io.audio.MIC_SOURCE
+import org.vosk.Recognizer
+import org.vosk.android.RecognitionListener
+import java.io.IOException
+import kotlin.math.roundToInt
+
+class MicSpeechService(private val recognizer: Recognizer, sampleRate: Float) {
+    private val sampleRate = sampleRate.toInt()
+    private val bufferSize = (this.sampleRate * BUFFER_SIZE_SECONDS).roundToInt()
+    private val mainHandler = Handler(Looper.getMainLooper())
+    private var recognizerThread: RecognizerThread? = null
+
+    @SuppressLint("MissingPermission")
+    private val recorder = AudioRecord(
+        MIC_SOURCE,
+        this.sampleRate,
+        AudioFormat.CHANNEL_IN_MONO,
+        AudioFormat.ENCODING_PCM_16BIT,
+        bufferSize * 2,
+    )
+
+    init {
+        if (recorder.state == AudioRecord.STATE_UNINITIALIZED) {
+            recorder.release()
+            throw IOException("Failed to initialize recorder. Microphone might be already in use.")
+        }
+    }
+
+    fun startListening(listener: RecognitionListener): Boolean {
+        if (recognizerThread != null) {
+            return false
+        }
+        recognizerThread = RecognizerThread(listener).also { it.start() }
+        return true
+    }
+
+    fun stop(): Boolean = stopRecognizerThread()
+
+    fun cancel(): Boolean {
+        recognizerThread?.paused = true
+        return stopRecognizerThread()
+    }
+
+    fun shutdown() {
+        recorder.release()
+    }
+
+    fun setPause(paused: Boolean) {
+        recognizerThread?.paused = paused
+    }
+
+    fun reset() {
+        recognizerThread?.reset = true
+    }
+
+    private fun stopRecognizerThread(): Boolean {
+        val thread = recognizerThread ?: return false
+        try {
+            thread.interrupt()
+            thread.join()
+        } catch (e: InterruptedException) {
+            Thread.currentThread().interrupt()
+        }
+        recognizerThread = null
+        return true
+    }
+
+    private inner class RecognizerThread(private val listener: RecognitionListener) : Thread() {
+        @Volatile
+        var paused = false
+
+        @Volatile
+        var reset = false
+
+        override fun run() {
+            recorder.startRecording()
+            if (recorder.recordingState == AudioRecord.RECORDSTATE_STOPPED) {
+                recorder.stop()
+                val e = IOException("Failed to start recording. Microphone might be already in use.")
+                mainHandler.post { listener.onError(e) }
+            }
+
+            val buffer = ShortArray(bufferSize)
+            while (!interrupted()) {
+                val nread = recorder.read(buffer, 0, buffer.size)
+                if (paused) {
+                    continue
+                }
+                if (reset) {
+                    recognizer.reset()
+                    reset = false
+                }
+                if (nread < 0) {
+                    throw RuntimeException("error reading audio buffer")
+                }
+                if (recognizer.acceptWaveForm(buffer, nread)) {
+                    val result = recognizer.result
+                    mainHandler.post { listener.onResult(result) }
+                } else {
+                    val partialResult = recognizer.partialResult
+                    mainHandler.post { listener.onPartialResult(partialResult) }
+                }
+            }
+
+            recorder.stop()
+            if (!paused) {
+                val finalResult = recognizer.finalResult
+                mainHandler.post { listener.onFinalResult(finalResult) }
+            }
+        }
+    }
+
+    companion object {
+        private const val BUFFER_SIZE_SECONDS = 0.2f
+    }
+}
