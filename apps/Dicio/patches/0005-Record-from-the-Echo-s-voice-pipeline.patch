+package org.stypox.dicio.io.audio
+
+import android.media.MediaRecorder
+
+/**
+ * RavenOS: the microphone source for the wake word and speech recognition. On the Echo Show
+ * the VOICE_RECOGNITION pipeline beamforms but applies no gain, so speech arrives about 20 dB
+ * quieter than from VOICE_COMMUNICATION, which adds gain, noise reduction and echo
+ * cancellation (the latter also lets "Hey Raven, turn off" through a ringing alarm).
+ */
+const val MIC_SOURCE = MediaRecorder.AudioSource.VOICE_COMMUNICATION
