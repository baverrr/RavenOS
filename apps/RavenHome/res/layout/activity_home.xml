<?xml version="1.0" encoding="utf-8"?>
<!-- Layout S: the background (video, photos or plain) fills the screen with a small
     clock in the corner; a tap reveals everything else until it times out. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/raven_bg">

    <TextureView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/photo_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/photo_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Darkens the background while the details are showing, so text stays readable. -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/raven_scrim" />

    <!-- Ambient: just the time (and the next alarm) in the corner. -->
    <LinearLayout
        android:id="@+id/ambient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="36dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/ambient_clock"
            style="@style/Raven.ClockAmbient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm" />

        <TextView
            android:id="@+id/ambient_alarm"
            style="@style/Raven.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:shadowColor="@color/raven_shadow"
            android:shadowRadius="10"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/hint"
        style="@style/Raven.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="40dp"
        android:shadowColor="@color/raven_shadow"
        android:shadowRadius="10"
        android:text="@string/tap_hint"
        android:visibility="gone" />

    <!-- Revealed details. -->
    <LinearLayout
        android:id="@+id/details"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="40dp"
        android:paddingEnd="56dp"
        android:paddingBottom="36dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock"
                    style="@style/Raven.ClockBig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm" />

                <TextClock
                    android:id="@+id/date"
                    style="@style/Raven.Date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE, MMMM d"
                    android:format24Hour="EEEE, d MMMM" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/weather_now"
                    style="@style/Raven.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:textSize="44sp" />

                <TextView
                    android:id="@+id/weather_detail"
                    style="@style/Raven.Caption"
                    android:textColor="@color/raven_text_muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:shadowColor="@color/raven_shadow"
                    android:shadowRadius="10" />
            </LinearLayout>
        </LinearLayout>

        <!-- Next alarm and running timers. -->
        <LinearLayout
            android:id="@+id/chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/now_playing"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:background="@drawable/glass_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:visibility="invisible">

                <ImageView
                    android:id="@+id/np_art"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/np_title"
                        style="@style/Raven.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/np_artist"
                        style="@style/Raven.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/np_prev"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:foreground="@drawable/focus_ring_oval"
                    android:contentDescription="@string/np_prev"
                    android:src="@drawable/ic_prev" />

                <ImageButton
                    android:id="@+id/np_play"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:foreground="@drawable/focus_ring_oval"
                    android:contentDescription="@string/np_play_pause"
                    android:scaleType="fitCenter"
                    android:padding="16dp"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/np_next"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:foreground="@drawable/focus_ring_oval"
                    android:contentDescription="@string/np_next"
                    android:src="@drawable/ic_next" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>

    <!-- Short notices from the home screen (Bluetooth pairing), instead of system toasts. -->
    <TextView
        android:id="@+id/notice"
        style="@style/Raven.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="48dp"
        android:maxWidth="560dp"
        android:background="@drawable/notice_bg"
        android:drawableStart="@drawable/ic_bluetooth"
        android:drawableTint="@color/raven_accent"
        android:drawablePadding="16dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:elevation="8dp"
        android:visibility="gone" />
</FrameLayout>
