<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/raven_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <ImageView
        android:id="@+id/ring_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:importantForAccessibility="no"
        android:tint="@color/raven_accent" />

    <TextClock
        style="@style/Raven.ClockBig"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textSize="160sp" />

    <TextView
        android:id="@+id/ring_label"
        style="@style/Raven.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="36sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ring_secondary"
            style="@style/Raven.Label"
            android:layout_width="wrap_content"
            android:layout_height="96dp"
            android:background="@drawable/chip_bg"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:minWidth="280dp"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/ring_stop"
            style="@style/Raven.Label"
            android:layout_width="wrap_content"
            android:layout_height="96dp"
            android:layout_marginStart="32dp"
            android:background="@drawable/accent_button_bg"
            android:focusedByDefault="true"
            android:gravity="center"
            android:minWidth="280dp"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:text="@string/stop"
            android:textColor="@color/raven_on_accent"
            android:textSize="26sp" />
    </LinearLayout>
</LinearLayout>
