<?xml version="1.0" encoding="utf-8"?>
<!-- An alarm or timer row: a glass card like the cards in Settings. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/settings_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_card" />
            <stroke android:width="1dp" android:color="@color/settings_card_stroke" />
            <corners android:radius="@dimen/settings_card_radius" />
        </shape>
    </item>
    <item android:drawable="@drawable/focus_ring_card" />
</ripple>
